# The Archive: the page shown while the machine starts and stops (Plymouth).
# The shell's paper, the archive's watercolour sprig inked in, the typed
# heading with a line ruled under it, and a word on what is happening. The
# pictures come from tools/make_splash.py, drawn for a 1800 px tall screen
# (the G14) and fitted to others.

W = Window.GetWidth();
H = Window.GetHeight();
k = H / 1800;

fun fit(img) {
    if (k > 0.97 && k < 1.03) return img;
    return img.Scale(Math.Int(img.GetWidth() * k + 0.5), Math.Int(img.GetHeight() * k + 0.5));
}

# ------------------------------------------------------------------ the sheet
Window.SetBackgroundTopColor(0.79, 0.78, 0.765);
Window.SetBackgroundBottomColor(0.79, 0.78, 0.765);
paper = Sprite(Image("paper.png").Scale(W, H));
paper.SetPosition(0, 0, -10);

sprig_img = fit(Image("sprig.png"));
sprig = Sprite(sprig_img);
sprig.SetPosition(Math.Int((W - sprig_img.GetWidth()) / 2), Math.Int(H * 0.40 - sprig_img.GetHeight() / 2), 1);
sprig.SetOpacity(0);

head_img = fit(Image("heading.png"));
head = Sprite(head_img);
head_y = Math.Int(H * 0.40 + sprig_img.GetHeight() / 2 + 46 * k);
head.SetPosition(Math.Int((W - head_img.GetWidth()) / 2), head_y, 1);
head.SetOpacity(0);

rule_img = fit(Image("rule.png"));
rule_w = rule_img.GetWidth();
rule_h = rule_img.GetHeight();
rule_x = Math.Int((W - rule_w) / 2);
rule_y = head_y + head_img.GetHeight() + 10 * k;
rule = Sprite();
rule.SetPosition(rule_x, rule_y, 1);

# what is happening: opening, closing, turning the page
mode = Plymouth.GetMode();
which = "boot";
if (mode == "shutdown") which = "shutdown";
if (mode == "reboot") which = "reboot";
if (mode == "updates" || mode == "system-upgrade" || mode == "firmware-upgrade") which = "updates";
line_img = fit(Image("line-" + which + ".png"));
line = Sprite(line_img);
line_y = rule_y + rule_h + 18 * k;
line.SetPosition(Math.Int((W - line_img.GetWidth()) / 2), line_y, 1);
line.SetOpacity(0);

# ------------------------------------------------------------------ the passphrase (an encrypted disk)
prompt_img = fit(Image("prompt.png"));
prompt = Sprite(prompt_img);
prompt.SetPosition(Math.Int((W - prompt_img.GetWidth()) / 2), line_y, 2);
prompt.SetOpacity(0);
bullet_img = fit(Image("bullet.png"));
bullets = [];
asking = 0;

fun show_bullets(n) {
    gap = bullet_img.GetWidth() + 4 * k;
    total = n * gap;
    x0 = (W - total) / 2;
    for (i = 0; i < n || bullets[i]; i++) {
        if (!bullets[i]) global.bullets[i] = Sprite(bullet_img);
        global.bullets[i].SetPosition(Math.Int(x0 + i * gap), Math.Int(line_y + prompt_img.GetHeight() + 10 * k), 2);
        if (i < n) global.bullets[i].SetOpacity(1); else global.bullets[i].SetOpacity(0);
    }
}

fun on_password(prompt_text, n) {
    global.asking = 1;
    prompt.SetOpacity(1);
    line.SetOpacity(0);
    show_bullets(n);
}

fun on_normal() {
    global.asking = 0;
    prompt.SetOpacity(0);
    show_bullets(0);
}

Plymouth.SetDisplayPasswordFunction(on_password);
Plymouth.SetDisplayNormalFunction(on_normal);

# ------------------------------------------------------------------ the inking
t = 0;
drawn = -1;

fun ease(x) {
    if (x <= 0) return 0;
    if (x >= 1) return 1;
    return x * x * (3 - 2 * x);
}

fun refresh() {
    global.t = t + 1 / 50;
    sprig.SetOpacity(ease(t / 0.9));
    head.SetOpacity(ease((t - 0.35) / 0.7));
    # the line ruled under the heading, left to right, once
    p = ease((t - 0.6) / 1.1);
    w = Math.Int(rule_w * p);
    if (w != drawn && w > 0) {
        rule.SetImage(rule_img.Scale(w, rule_h));
        global.drawn = w;
    }
    # the word on what is happening, breathing while it works
    if (!asking) {
        a = ease((t - 1.2) / 0.6);
        line.SetOpacity(a * (0.78 + 0.22 * Math.Cos((t - 1.8) * 2.4)));
    }
}
Plymouth.SetRefreshFunction(refresh);
