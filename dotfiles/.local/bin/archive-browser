#!/usr/bin/env bash
# archive-browser: open your default web browser (Super+B), with any
# arguments (a web address). The default is what the system says
# (xdg-settings get default-web-browser); set it with, for example:
#   xdg-settings set default-web-browser zen.desktop
# Firefox when no default is set or it cannot be started.
set -u
app=$(xdg-settings get default-web-browser 2>/dev/null || true)
app=${app%.desktop}
if [[ -n $app ]] && command -v gtk-launch >/dev/null && gtk-launch "$app" "$@" 2>/dev/null; then
    exit 0
fi
# no gtk-launch: read the entry's Exec line ourselves
for dir in "${XDG_DATA_HOME:-$HOME/.local/share}/applications" /usr/local/share/applications /usr/share/applications; do
    f="$dir/$app.desktop"
    [[ -n $app && -f $f ]] || continue
    exe=$(sed -n 's/^Exec=//p' "$f" | head -1 | sed 's/ *%[a-zA-Z]//g')
    [[ -n $exe ]] && { setsid -f sh -c "exec $exe \"\$@\"" sh "$@" >/dev/null 2>&1; exit 0; }
done
setsid -f firefox "$@" >/dev/null 2>&1
