#!/usr/bin/env python3
"""archive-gramophone: the record player's library and its player.

    archive-gramophone library [music dir]   the albums, as JSON (for the shell)
    archive-gramophone start                 the player (mpv), if not running
    archive-gramophone stop                  stop it

Albums are folders: every folder in ~/Music (or the "music" setting, or
XDG_MUSIC_DIR) that holds audio files is one record; loose files in the top
folder are filed together as "Loose leaves". Titles, artists and years come
from the files' tags (ffprobe), else from the names. The sleeve is the
folder's cover.jpg / folder.png / front.* (or any picture in it), else the
picture inside the first track. Everything read is cached in
~/.cache/archive/gramophone, so a second look is instant.

The player is mpv, without a window, controlled by the shell over
$XDG_RUNTIME_DIR/archive-gramophone.sock. With mpv-mpris installed it also
shows up as an ordinary media player (media keys, the Audio Archive card).
"""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

AUDIO = {".mp3", ".flac", ".ogg", ".oga", ".opus", ".m4a", ".aac", ".wav", ".wma", ".alac", ".aiff", ".aif", ".ape", ".wv", ".mka"}
IMAGES = (".jpg", ".jpeg", ".png", ".webp", ".bmp")
COVER_NAMES = ("cover", "folder", "front", "album", "albumart", "albumartsmall")

HOME = os.path.expanduser("~")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "archive", "gramophone")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
SOCKET = os.path.join(RUNTIME, "archive-gramophone.sock")


def music_dir():
    if len(sys.argv) > 2 and sys.argv[2]:
        return os.path.expanduser(sys.argv[2])
    try:
        cfg = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "archive", "settings.json")
        with open(cfg, encoding="utf-8") as f:
            d = json.load(f).get("music")
        if d:
            return os.path.expanduser(d)
    except (OSError, ValueError, AttributeError):
        pass
    try:
        d = subprocess.run(["xdg-user-dir", "MUSIC"], capture_output=True, text=True, timeout=2).stdout.strip()
        if d and d != HOME and os.path.isdir(d):
            return d
    except (OSError, subprocess.SubprocessError):
        pass
    return os.path.join(HOME, "Music")


# ---------------------------------------------------------------- tags
def probe(path):
    """Tags and length of one file: {title, artist, album, albumartist, date, track, disc, length, pic}."""
    try:
        out = subprocess.run(
            ["ffprobe", "-v", "quiet", "-print_format", "json", "-show_format", "-show_streams", path],
            capture_output=True, text=True, timeout=20).stdout
        d = json.loads(out or "{}")
    except (OSError, ValueError, subprocess.SubprocessError):
        d = {}
    fmt = d.get("format", {})
    tags = {k.lower(): v for k, v in (fmt.get("tags") or {}).items()}
    # Ogg / Opus keep their tags on the stream
    for s in d.get("streams", []):
        if s.get("codec_type") == "audio":
            for k, v in (s.get("tags") or {}).items():
                tags.setdefault(k.lower(), v)
    pic = any(s.get("codec_type") == "video" for s in d.get("streams", []))
    try:
        length = float(fmt.get("duration") or 0)
    except ValueError:
        length = 0

    def num(v):
        m = re.match(r"\s*(\d+)", str(v or ""))
        return int(m.group(1)) if m else 0
    return {
        "title": tags.get("title", ""),
        "artist": tags.get("artist", ""),
        "album": tags.get("album", ""),
        "albumartist": tags.get("album_artist") or tags.get("albumartist") or "",
        "date": (re.search(r"\d{4}", tags.get("date", "") or tags.get("year", "") or "") or [""])[0],
        "track": num(tags.get("track")),
        "disc": num(tags.get("disc")),
        "length": round(length, 1),
        "pic": pic,
    }


def name_title(file):
    """A title from a file name: '03 - Some Song.flac' -> 'Some Song'."""
    t = os.path.splitext(os.path.basename(file))[0]
    t = re.sub(r"^\s*\d{1,3}\s*[-._)]*\s*", "", t) or t
    return t.replace("_", " ").strip()


def name_number(file):
    m = re.match(r"\s*(\d{1,3})", os.path.basename(file))
    return int(m.group(1)) if m else 0


# ---------------------------------------------------------------- covers
def cover_for(folder, files, tags):
    try:
        pics = [f for f in os.listdir(folder) if f.lower().endswith(IMAGES)]
    except OSError:
        pics = []
    for want in COVER_NAMES:
        for p in pics:
            if os.path.splitext(p)[0].lower() == want:
                return os.path.join(folder, p)
    if pics:
        return os.path.join(folder, sorted(pics)[0])
    # the picture inside the first track that has one
    for f in files:
        if tags.get(f, {}).get("pic"):
            st = os.stat(f)
            key = hashlib.sha1(f"{f}|{st.st_mtime}|{st.st_size}".encode()).hexdigest()[:16]
            out = os.path.join(CACHE, "covers", key + ".jpg")
            if not os.path.exists(out):
                os.makedirs(os.path.dirname(out), exist_ok=True)
                subprocess.run(["ffmpeg", "-v", "quiet", "-y", "-i", f, "-an", "-frames:v", "1",
                                "-vf", "scale='min(800,iw)':-2", out], timeout=30)
            if os.path.exists(out):
                return out
    return ""


def track_cover(f, tags):
    """The picture inside one track (cached as a jpg), or ""."""
    if not tags.get(f, {}).get("pic"):
        return ""
    try:
        st = os.stat(f)
    except OSError:
        return ""
    key = hashlib.sha1(f"{f}|{st.st_mtime}|{st.st_size}".encode()).hexdigest()[:16]
    out = os.path.join(CACHE, "covers", key + ".jpg")
    if not os.path.exists(out):
        os.makedirs(os.path.dirname(out), exist_ok=True)
        try:
            subprocess.run(["ffmpeg", "-v", "quiet", "-y", "-i", f, "-an", "-frames:v", "1",
                            "-vf", "scale='min(800,iw)':-2", out], timeout=30)
        except (OSError, subprocess.SubprocessError):
            return ""
    return out if os.path.exists(out) else ""


# ---------------------------------------------------------------- the library
def library():
    root = music_dir()
    os.makedirs(CACHE, exist_ok=True)
    cache_file = os.path.join(CACHE, "tags.json")
    try:
        with open(cache_file, encoding="utf-8") as f:
            cache = json.load(f)
    except (OSError, ValueError):
        cache = {}

    folders = {}
    if os.path.isdir(root):
        for dirpath, dirs, files in os.walk(root, followlinks=True):
            dirs[:] = sorted(d for d in dirs if not d.startswith("."))
            tracks = [os.path.join(dirpath, f) for f in files
                      if not f.startswith(".") and os.path.splitext(f)[1].lower() in AUDIO]
            if tracks:
                folders[dirpath] = tracks

    # tags for every file, from the cache when the file has not changed
    every = [f for fs in folders.values() for f in fs]
    stamp = {}
    for f in every:
        try:
            st = os.stat(f)
            stamp[f] = f"{st.st_mtime}|{st.st_size}"
        except OSError:
            stamp[f] = ""
    todo = [f for f in every if cache.get(f, {}).get("stamp") != stamp[f]]
    if todo:
        with ThreadPoolExecutor(max_workers=8) as pool:
            for f, t in zip(todo, pool.map(probe, todo)):
                t["stamp"] = stamp[f]
                cache[f] = t
    tags = {f: cache.get(f, {}) for f in every}
    # forget files that are gone
    cache = {f: cache[f] for f in every if f in cache}
    try:
        with open(cache_file + ".tmp", "w", encoding="utf-8") as f:
            json.dump(cache, f)
        os.replace(cache_file + ".tmp", cache_file)
    except OSError:
        pass

    # each track's own picture (the record's label shows it), drawn out once
    with ThreadPoolExecutor(max_workers=6) as pool:
        own = dict(zip(every, pool.map(lambda f: track_cover(f, tags), every)))

    albums = []
    for folder, files in folders.items():
        loose = os.path.normpath(folder) == os.path.normpath(root)
        files.sort(key=lambda f: (tags[f].get("disc") or 0, tags[f].get("track") or name_number(f), os.path.basename(f).lower()))
        first = tags[files[0]]
        album = "Loose leaves" if loose else (first.get("album") or os.path.basename(folder))
        rel = os.path.relpath(folder, root)
        parent = os.path.basename(os.path.dirname(folder)) if os.sep in rel else ""
        artists = {tags[f].get("albumartist") or tags[f].get("artist") for f in files} - {""}
        artist = (first.get("albumartist") or (artists.pop() if len(artists) == 1 else ("Various" if artists else parent)))
        if not loose and not artist:
            m = re.match(r"(.+?)\s+-\s+(.+)", os.path.basename(folder))     # "Artist - Album"
            if m:
                artist = m.group(1)
                if not first.get("album"):
                    album = m.group(2)
        folder_cover = "" if loose else cover_for(folder, files, tags)
        albums.append({
            "key": folder,
            "name": album,
            "artist": artist,
            "year": next((tags[f].get("date") for f in files if tags[f].get("date")), ""),
            "dir": folder,
            "where": "~/" + os.path.relpath(folder, HOME) if folder.startswith(HOME) else folder,
            "cover": folder_cover,
            "tracks": [{
                "file": f,
                "title": tags[f].get("title") or name_title(f),
                "artist": tags[f].get("artist", ""),
                "length": tags[f].get("length", 0),
                "cover": own.get(f) or folder_cover,
            } for f in files],
        })
    albums.sort(key=lambda a: (a["name"] == "Loose leaves", a["artist"].lower(), a["name"].lower()))
    json.dump({"root": root, "albums": albums}, sys.stdout)
    print()


# ---------------------------------------------------------------- the player
def running():
    if not os.path.exists(SOCKET):
        return False
    import socket
    s = socket.socket(socket.AF_UNIX)
    try:
        s.connect(SOCKET)
        return True
    except OSError:
        return False
    finally:
        s.close()


def start():
    if running():
        return
    if not shutil.which("mpv"):
        sys.exit("archive-gramophone: mpv is not installed (sudo pacman -S mpv mpv-mpris)")
    try:
        os.unlink(SOCKET)
    except OSError:
        pass
    subprocess.Popen(
        ["mpv", "--idle=yes", "--no-video", "--audio-display=no", "--no-terminal", "--force-window=no",
         "--title=archive-gramophone", "--input-ipc-server=" + SOCKET, "--volume=100"],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True)


def stop():
    if running():
        import socket
        s = socket.socket(socket.AF_UNIX)
        s.connect(SOCKET)
        s.sendall(b'{"command":["quit"]}\n')
        s.close()


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "library"
    if cmd == "library":
        library()
    elif cmd == "start":
        start()
    elif cmd == "stop":
        stop()
    else:
        sys.exit("usage: archive-gramophone library [dir] | start | stop")
