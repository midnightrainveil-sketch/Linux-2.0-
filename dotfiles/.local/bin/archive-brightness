#!/usr/bin/env bash
# archive-brightness: the screen's brightness.
#
#   archive-brightness get              current level, in percent
#   archive-brightness set <percent>
#   archive-brightness up | down        5 % steps (the brightness keys)
#   archive-brightness dim | restore    for hypridle: lower to 15 %, then back
#   archive-brightness init             at login: clear any software dimming
#   archive-brightness reset            back to the plain backlight at 70 %
#   archive-brightness doctor           what it found, for troubleshooting
#
# It sets the panel's backlight (/sys/class/backlight), linearly, never
# below 5 %: the G14's OLED goes almost black and turns red near zero. On a
# panel without a working backlight, "brightness": "gamma" in
# ~/.config/archive/settings.json dims in software instead (hyprsunset);
# "backlightDevice" picks a backlight by name.
set -uo pipefail

state="${XDG_STATE_HOME:-$HOME/.local/state}/archive"
settings="${XDG_CONFIG_HOME:-$HOME/.config}/archive/settings.json"
mkdir -p "$state"
# left by an earlier version that guessed the backlight was broken
rm -f "$state/backlight-broken" "$state/backlight-fails"

setting() { jq -r --arg k "$1" '.[$k] // empty' "$settings" 2>/dev/null; }

# the backlight to use: the one asked for, else the likeliest
device() {
    local want d pat
    want=$(setting backlightDevice)
    if [[ -n $want && -d /sys/class/backlight/$want ]]; then
        echo "$want"
        return
    fi
    for pat in 'amdgpu_bl*' 'nvidia_wmi_ec_backlight' 'intel_backlight' 'nvidia_*' 'acpi_video*' '*'; do
        for d in /sys/class/backlight/$pat; do
            if [[ -r $d/max_brightness && $(cat "$d/max_brightness") -gt 0 ]]; then
                basename "$d"
                return
            fi
        done
    done
}

mode() {
    if [[ $(setting brightness) == gamma || -z $(device) ]]; then echo gamma; else echo backlight; fi
}

clamp() { # clamp <value> <min> <max>
    local v=$1
    ((v < $2)) && v=$2
    ((v > $3)) && v=$3
    echo "$v"
}

# ---------------------------------------------------------------- software dimming
gamma_get() { cat "$state/gamma" 2>/dev/null || echo 100; }

# hyprsunset holds the screen's colour matrix while it runs; when it quits
# Hyprland puts the colours back exactly as they were
gamma_off() {
    pkill -x hyprsunset 2>/dev/null || true
    rm -f "$state/gamma"
}

gamma_set() {
    local p; p=$(clamp "$1" 40 100)
    if ((p >= 100)); then
        gamma_off
        return
    fi
    if ! pgrep -x hyprsunset >/dev/null; then
        command -v hyprsunset >/dev/null || { echo "archive-brightness: hyprsunset is not installed" >&2; return 1; }
        setsid -f hyprsunset --identity --gamma "$p" >/dev/null 2>&1
        sleep 0.3
    fi
    hyprctl hyprsunset gamma "$p" >/dev/null 2>&1
    echo "$p" >"$state/gamma"
}

# ---------------------------------------------------------------- the level
get() {
    if [[ $(mode) == backlight ]]; then
        brightnessctl -m -d "$(device)" 2>/dev/null | cut -d, -f4 | tr -d '%'
    else
        gamma_get
    fi
}

set_level() {
    if [[ $(mode) == backlight ]]; then
        # (no software dimming on top of the backlight)
        pgrep -x hyprsunset >/dev/null && gamma_off
        brightnessctl -q -d "$(device)" set "$(clamp "$1" 5 100)%"
    else
        gamma_set "$1"
    fi
}

case ${1:-get} in
    get) get ;;
    set)
        [[ ${2:-} =~ ^[0-9]+$ ]] || { echo "usage: archive-brightness set <percent>" >&2; exit 2; }
        set_level "$2"
        ;;
    up) set_level $(($(get) + 5)) ;;
    down) set_level $(($(get) - 5)) ;;
    dim)
        get >"$state/brightness-saved"
        set_level 15
        ;;
    restore)
        [[ -f $state/brightness-saved ]] && set_level "$(cat "$state/brightness-saved")"
        rm -f "$state/brightness-saved"
        ;;
    init)
        if [[ $(mode) == gamma ]]; then
            [[ $(gamma_get) != 100 ]] && gamma_set "$(gamma_get)"
        else
            gamma_off
        fi
        ;;
    reset)
        gamma_off
        rm -f "$state/brightness-saved"
        [[ -n $(device) ]] && brightnessctl -q -d "$(device)" set 70%
        echo "brightness: backlight $(device), 70 %"
        ;;
    doctor)
        echo "mode:     $(mode)  (setting: $(setting brightness || true))"
        echo "device:   $(device)"
        for d in /sys/class/backlight/*; do
            [[ -e $d ]] || { echo "backlights: none"; break; }
            echo "  $(basename "$d"): brightness $(cat "$d/brightness") actual $(cat "$d/actual_brightness" 2>/dev/null) max $(cat "$d/max_brightness")"
        done
        echo "software dimming: $(gamma_get) %  (hyprsunset $(pgrep -x hyprsunset >/dev/null && echo running || echo 'not running'))"
        command -v supergfxctl >/dev/null && echo "gpu mode: $(supergfxctl -g 2>/dev/null)"
        echo "kernel:   $(uname -r)"
        ;;
    *) echo "usage: archive-brightness get|set <percent>|up|down|dim|restore|init|reset|doctor" >&2; exit 2 ;;
esac
