#!/usr/bin/env python3
"""archive-print: an album cover printed in the archive's own inks.

    archive-print <file path, file:// or http(s):// URL>

Prints the path of the print (a small PNG, kept in
~/.cache/archive/prints, so a cover is printed once). Each colour is moved
toward the nearest of the archive's inks (madder, ochre, sage, ink blue,
their tints, and paper), keeping a little of the original's own softened
colour, with a fine grain: as if printed on an old magazine page.
"""
import hashlib
import os
import sys
import urllib.parse
import urllib.request

import numpy as np
from PIL import Image

SIZE = 280
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "archive", "prints")

# paper, madder, ochre, sage, ink blue, ink, a light ochre and a madder tint
INKS = np.array([(220, 214, 202), (142, 81, 72), (162, 131, 74), (110, 123, 90),
                 (64, 78, 110), (62, 61, 66), (198, 168, 120), (176, 132, 122)], np.float32)


def load(src):
    if src.startswith("file://"):
        return Image.open(urllib.parse.unquote(src[7:]))
    if src.startswith(("http://", "https://")):
        req = urllib.request.Request(src, headers={"User-Agent": "archive-print"})
        with urllib.request.urlopen(req, timeout=8) as r:
            import io
            return Image.open(io.BytesIO(r.read()))
    return Image.open(src)


def magazine(a):
    # softened colour, warm, never black and never white
    g = a @ np.array([0.299, 0.587, 0.114], np.float32)
    a = g[..., None] + (a - g[..., None]) * 0.55
    a = a * (0.88 + 0.12 * np.array([1.0, 0.94, 0.82], np.float32))
    ink, paper = np.array([0.24, 0.23, 0.26], np.float32), np.array([0.88, 0.85, 0.79], np.float32)
    return ink + (paper - ink) * np.clip((a - 0.04) / 0.94, 0, 1)


def main():
    if len(sys.argv) != 2 or not sys.argv[1]:
        sys.exit(__doc__.strip())
    src = sys.argv[1]
    os.makedirs(CACHE, exist_ok=True)
    out = os.path.join(CACHE, hashlib.sha1(src.encode()).hexdigest()[:20] + ".png")
    if src.startswith("file://") or not src.startswith(("http://", "https://")):
        # a local file may change under the same name: key on its time too
        path = urllib.parse.unquote(src[7:]) if src.startswith("file://") else src
        try:
            stamp = str(os.stat(path).st_mtime_ns)
        except OSError:
            stamp = ""
        out = os.path.join(CACHE, hashlib.sha1((src + stamp).encode()).hexdigest()[:20] + ".png")
    if not os.path.exists(out):
        img = load(src).convert("RGB")
        w, h = img.size
        s = min(w, h)
        img = img.crop(((w - s) // 2, (h - s) // 2, (w - s) // 2 + s, (h - s) // 2 + s)).resize((SIZE, SIZE), Image.LANCZOS)
        a = np.asarray(img).astype(np.float32)
        flat = a.reshape(-1, 3)
        near = INKS[((flat[:, None, :] - INKS[None, :, :]) ** 2).sum(-1).argmin(1)].reshape(a.shape)
        a = 0.72 * near + 0.28 * magazine(a / 255) * 255
        a += np.random.default_rng(7).normal(0, 6, a.shape[:2]).astype(np.float32)[..., None]
        tmp = out + ".part.png"
        Image.fromarray(np.clip(a, 0, 255).astype(np.uint8)).save(tmp)
        os.replace(tmp, out)
        # keep the cache small: the 200 newest prints
        prints = sorted((os.path.join(CACHE, f) for f in os.listdir(CACHE) if f.endswith(".png")), key=os.path.getmtime)
        for old in prints[:-200]:
            try:
                os.remove(old)
            except OSError:
                pass
    print(out)


if __name__ == "__main__":
    main()
