#!/usr/bin/env bash
# archive-shell: run the shell (Quickshell), and start it again if it crashes.
#
#   archive-shell        what Hyprland runs at login (one at a time)
#
# The bar, the desk cards and every Super key that opens a panel (Super+Space,
# Super+R, Super+A ...) belong to the shell: if it crashed, they would all
# stay dead until the next login. Here a crash brings it back within a second.
# A deliberate stop (qs kill, pkill qs, archive-wallpaper) is left alone, and
# after 5 crashes in 2 minutes it gives up rather than loop. Crashes are noted
# in ~/.local/state/archive/shell-crashes (Quickshell keeps its own report in
# ~/.cache/quickshell/crashes).
set -u
state="${XDG_STATE_HOME:-$HOME/.local/state}/archive"
mkdir -p "$state"
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/archive-shell.lock"
flock -w 5 9 || exit 0        # one keeper is enough (a stopping one has 5 s to go)

crashes=()
while true; do
    qs "$@"
    code=$?
    case $code in
        0 | 130 | 143) exit 0 ;;          # quit, Ctrl+C, or stopped on purpose
    esac
    now=$(date +%s)
    echo "$(date '+%F %T') the shell stopped (exit $code); starting it again" >>"$state/shell-crashes"
    crashes+=("$now")
    recent=0
    for t in "${crashes[@]}"; do (( now - t < 120 )) && recent=$((recent + 1)); done
    if (( recent >= 5 )); then
        echo "$(date '+%F %T') 5 crashes in 2 minutes: not starting it again" >>"$state/shell-crashes"
        exit 1
    fi
    sleep 1
done
