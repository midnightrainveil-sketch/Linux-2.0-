#!/usr/bin/env bash
# archive-screenshot: file a screen record.
#   archive-screenshot region | window | screen
# Saved to ~/Pictures/Archive/ and copied to the clipboard. The shell shows
# it as a photograph dropped onto the desk (a flash, a print with a
# paperclip, then it files itself away); without the shell, a notification.
set -euo pipefail
dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Archive"
mkdir -p "$dir"
file="$dir/record-$(date +%Y%m%d-%H%M%S).png"

# a print from the last shot (pinned or not) must not end up in this one:
# if one is on the desk, take it off and give the screen a moment to be
# drawn without it (asking the shell costs a moment, so only then)
if hyprctl layers -j 2>/dev/null | grep -q '"archive-photograph"'; then
    qs ipc call photo clear >/dev/null 2>&1 && sleep 0.12
fi
# quick PNG compression: the full panel at the default level takes a while
grim() { command grim -l 1 "$@"; }

case ${1:-region} in
    region)
        geom=$(slurp -d -b '1e1d2233' -c '34405eff' -s '00000000' -w 2) || exit 0
        grim -g "$geom" "$file"
        ;;
    window)
        geom=$(hyprctl activewindow -j | jq -r 'if .at then "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])" else empty end')
        if [[ -n $geom ]]; then
            grim -g "$geom" "$file"
        else
            # no window has focus: the screen it is on, then
            grim -o "$(hyprctl activeworkspace -j | jq -r '.monitor')" "$file"
        fi
        ;;
    screen)
        mon=$(hyprctl activeworkspace -j | jq -r '.monitor')
        grim -o "$mon" "$file"
        ;;
    *) echo "usage: archive-screenshot region|window|screen" >&2; exit 2 ;;
esac

# the print on the desk and the clipboard at the same time
wl-copy --type image/png <"$file" &
if qs ipc call photo develop "$file" >/dev/null 2>&1; then wait; exit 0; fi
wait
notify-send --app-name "Camera Lucida" \
    --hint string:x-archive-stamp:FILED \
    --hint string:x-archive-sound:capture \
    --hint "string:image-path:$file" \
    "Screen record filed." "${file/#$HOME/\~}"
