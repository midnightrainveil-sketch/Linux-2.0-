#!/usr/bin/env bash
# archive-bars: build the "archivebars" title-bar plugin for this Hyprland.
#
#   archive-bars build     fetch hyprbars for your Hyprland version, patch, compile
#   archive-bars update    build only if Hyprland or the plugin changed since
#                          the last build
#   archive-bars ensure    the same, quietly (run at every login)
#   archive-bars status
#   archive-bars crashed   exit 0 if Hyprland crashed inside this build of the
#                          plugin (the config then leaves it out; rebuild or
#                          `archive-bars retry` to try again)
#   archive-bars retry     forget such a crash
#   archive-bars off       leave the title bars out from the next login on,
#                          until `archive-bars on`
#   archive-bars on
#
# archivebars is hyprbars with the additions the reference windows need: a
# ruled line under the bar, a typed glyph ("-") on its right, and the torn
# paper edge around every window (see archivebars/deckle.hpp). It is
# compiled against the Hyprland headers your distribution installed
# (/usr/include/hyprland), so it always matches the running compositor.
# If a build fails, the config simply runs without title bars until it works.
set -euo pipefail

data="${XDG_DATA_HOME:-$HOME/.local/share}/archive/plugins"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/archive/archivebars"
patcher="$data/archivebars/patch.py"
so="$data/archivebars.so"
stamp="$data/archivebars.version"
log="$cache/build.log"
mkdir -p "$data" "$cache"

# what the plugin was built from: the Hyprland commit and our own sources
want_stamp() {
    local dir; dir=$(dirname "$(readlink -f "$patcher")")   # the repo copy, new files included
    echo "$(hypr_commit) $(cat "$dir"/*.py "$dir"/*.?pp 2>/dev/null | sha1sum | cut -c1-12)"
}

# the installed Hyprland (the one the headers belong to, and the one the next
# login runs), else the running one
hypr_commit() {
    local c
    c=$(Hyprland --version 2>/dev/null | grep -oE '[0-9a-f]{40}' | head -n1 || true)
    if [[ -z $c && -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
        c=$(hyprctl version -j 2>/dev/null | jq -r '.commit // empty' || true)
    fi
    echo "$c"
}

build() {
    local commit; commit=$(hypr_commit)
    [[ -n $commit ]] || { echo "archive-bars: cannot tell which Hyprland is installed" >&2; return 1; }
    echo "archive-bars: Hyprland commit $commit"

    local repo="$cache/hyprland-plugins"
    if [[ -d $repo/.git ]]; then
        git -C "$repo" fetch -q origin || return 1
    else
        git clone -q https://github.com/hyprwm/hyprland-plugins "$repo" || return 1
    fi
    # hyprland-plugins pins a plugins commit to each Hyprland release
    local pin
    pin=$(git -C "$repo" show origin/HEAD:hyprpm.toml | grep -F "\"$commit\"" | grep -oE '"[0-9a-f]{40}"' | sed -n 2p | tr -d '"' || true)
    if [[ -n $pin ]]; then
        git -C "$repo" checkout -q --force "$pin" || return 1
    else
        echo "archive-bars: no pin for this Hyprland; using the latest hyprbars"
        git -C "$repo" checkout -q --force origin/HEAD || return 1
    fi

    # headers: the ones your distribution installed, else hyprpm's copy
    if ! pkg-config --exists hyprland; then
        for root in "/var/cache/hyprpm/$USER/headersRoot" "${XDG_DATA_HOME:-$HOME/.local/share}/hyprpm/headersRoot"; do
            [[ -d $root/share/pkgconfig ]] && export PKG_CONFIG_PATH="$root/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
        done
        if ! pkg-config --exists hyprland; then
            echo "archive-bars: fetching Hyprland headers with hyprpm"
            hyprpm update
            for root in "/var/cache/hyprpm/$USER/headersRoot" "${XDG_DATA_HOME:-$HOME/.local/share}/hyprpm/headersRoot"; do
                [[ -d $root/share/pkgconfig ]] && export PKG_CONFIG_PATH="$root/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
            done
        fi
    fi

    local work="$cache/work"
    rm -rf "$work"
    # (each step stops the build on failure: `ensure` runs this in an if,
    # where set -e does not apply, and must not stamp a failed build)
    cp -r "$repo/hyprbars" "$work" || return 1
    python3 "$patcher" "$work" || return 1
    # Hyprland's headers include Lua's; find them wherever the distribution keeps them
    local lua_cflags=""
    for pc in lua5.5 lua55 lua-5.5 lua; do
        if pkg-config --exists "$pc"; then lua_cflags=$(pkg-config --cflags "$pc"); break; fi
    done
    make -C "$work" CXX="${CXX:-g++} $lua_cflags" all || return 1
    install -m 644 "$work/hyprbars.so" "$so" || return 1
    want_stamp >"$stamp"
    echo "archive-bars: built $so"
}

up_to_date() {
    [[ -f $so && -f $stamp && $(cat "$stamp") == "$(want_stamp)" ]]
}

# Make a running Hyprland use the new build, but only if it has no copy of the
# plugin loaded yet (a first build): the reload then loads it. Swapping a
# loaded plugin out of a running Hyprland can take the session down, so an
# updated build waits for the next login.
activate() {
    [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} && -z ${ARCHIVE_NO_RELOAD:-} ]] || return 0
    [[ $(hyprctl version -j 2>/dev/null | jq -r '.commit // empty') == "$(hypr_commit)" ]] || return 0
    if hyprctl plugin list 2>/dev/null | grep -q archivebars; then
        notify-send --app-name "Archive" "Title bars updated." "They change at your next login." >/dev/null 2>&1 || true
        return 0
    fi
    hyprctl reload >/dev/null 2>&1 || true
}

# Hyprland writes a crash report with a backtrace; if a report newer than this
# build has the plugin in its backtrace, the plugin caused it
crash_reports="${XDG_CACHE_HOME:-$HOME/.cache}/hyprland"
off_flag="${XDG_STATE_HOME:-$HOME/.local/state}/archive/bars-off"

crashed() {
    [[ -f $off_flag ]] && return 0      # switched off by hand: the config leaves them out the same way
    [[ -f $so ]] || return 1
    local r
    while IFS= read -r -d '' r; do
        awk '/^Backtrace:/ { b = 1 } /^Log tail:/ { b = 0 } b && /archivebars\.so/ { f = 1 } END { exit !f }' "$r" && return 0
    done < <(find "$crash_reports" -maxdepth 1 -name 'hyprlandCrashReport*.txt' -newer "$so" -print0 2>/dev/null)
    return 1
}

case ${1:-build} in
    build)
        build 2>&1 | tee "$log"
        [[ ${PIPESTATUS[0]} -eq 0 ]] || exit 1
        activate
        ;;
    update)
        # build only if needed (setup.sh): an unchanged build keeps its date,
        # so a crash it caused still counts (see `crashed`)
        if up_to_date; then
            echo "archive-bars: already built for this Hyprland"
            exit 0
        fi
        build 2>&1 | tee "$log"
        [[ ${PIPESTATUS[0]} -eq 0 ]] || exit 1
        activate
        ;;
    ensure)
        up_to_date && exit 0
        if build >"$log" 2>&1; then
            activate
        else
            notify-send --app-name "Archive" "Title bars not built." "See $log" || true
        fi
        ;;
    crashed) crashed ;;
    off)
        mkdir -p "$(dirname "$off_flag")"
        touch "$off_flag"
        echo "archive-bars: the title bars stay off from your next login (archive-bars on brings them back)"
        ;;
    on)
        rm -f "$off_flag"
        touch "$so" 2>/dev/null || true
        echo "archive-bars: the title bars load again at your next login"
        ;;
    retry)
        touch "$so" 2>/dev/null || true   # older reports no longer count
        echo "archive-bars: the title bars load again at your next login"
        ;;
    status)
        if [[ -f $so ]]; then
            echo "built for $(cat "$stamp" 2>/dev/null), running $(hypr_commit)"
        else
            echo "not built"
        fi
        ;;
    *) echo "usage: archive-bars build|update|ensure|status|crashed|retry|off|on" >&2; exit 2 ;;
esac
