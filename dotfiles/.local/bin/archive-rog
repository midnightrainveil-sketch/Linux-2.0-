#!/usr/bin/env bash
# archive-rog: the G14's graphics and power, set up once and left alone.
#
#   archive-rog gpu       the NVIDIA side: the driver built for every kernel
#                         you have installed (it needs that kernel's headers),
#                         Hybrid mode, the dGPU powering off when unused and
#                         surviving suspend. Reboot afterwards.
#   archive-rog power     the profile follows the charger: Quiet on battery,
#                         Balanced plugged in (asusd switches it)
#   archive-rog calm      the profile stays what you chose: no switching
#   archive-rog switch    GPU switching in ROG Control (its GPU page): asusd
#                         does it itself since asusctl 6.3.9, and the old
#                         supergfxd, still running, fights it; this removes
#                         supergfxctl and restarts asusd. Log out afterwards.
#   archive-rog sleep     quick, clean waking: with NVIDIA driver 595 or newer
#                         (open modules) the driver suspends itself, so its
#                         systemd services, which switch to a text console
#                         (the black screen with a blinking cursor) and back,
#                         are switched off. Reboot afterwards.
#   archive-rog status    what is set, and what the dGPU is doing
#
# power and calm also quieten ROG Control: no notifications, and it quits
# when you close it instead of staying in the background.
#
# Hybrid is "screen on the iGPU, dGPU wakes for whatever asks for it": the
# MUX stays on the iGPU and the dGPU sleeps (no power) when nothing uses it,
# so on battery it is as good as off. Integrated (ROG Control's GPU page)
# removes it entirely, but every switch needs a log-out, so it is not done
# automatically. ROG Control switches through the kernel's asus-armoury
# driver, which is in Linux 6.19 and newer: on an older kernel (linux-lts
# 6.18) its GPU page has nothing to switch.
#
# asusd's own config is /etc/asusd/asusd.ron (the original is kept next to
# it as asusd.ron.archive-bak); ROG Control's is ~/.config/rog/.
set -euo pipefail
asusd_cfg=/etc/asusd/asusd.ron
rcc_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/rog/rog-control-center.cfg"

# ---------------------------------------------------------------- asusd
# edit_asusd <sed expressions...>: asusd writes its config back when it
# stops, so the file is edited while it is stopped
edit_asusd() {
    [[ -f $asusd_cfg ]] || { echo "asusd: no $asusd_cfg (is asusctl installed?)"; return 0; }
    sudo systemctl stop asusd.service
    [[ -f $asusd_cfg.archive-bak ]] || sudo cp "$asusd_cfg" "$asusd_cfg.archive-bak"
    local args=()
    for e in "$@"; do args+=(-e "$e"); done
    sudo sed -i -E "${args[@]}" "$asusd_cfg"
    sudo systemctl start asusd.service
}

quiet_rcc() {
    if [[ -f $rcc_cfg ]]; then
        if pkill -x rog-control-center 2>/dev/null; then sleep 1; fi   # it saves on exit
        sed -i -E \
            -e 's/(run_in_background: *)true/\1false/' \
            -e 's/(startup_in_background: *)true/\1false/' \
            -e 's/(enabled: *)true/\1false/' \
            -e 's/(enable_(dgpu_)?notifications: *)true/\1false/' \
            "$rcc_cfg"
        echo "ROG Control: no notifications, quits when closed"
    fi
}

power() {
    edit_asusd \
        's/^(\s*change_platform_profile_on_ac: *)\w+/\1true/' \
        's/^(\s*change_platform_profile_on_battery: *)\w+/\1true/' \
        's/^(\s*platform_profile_on_ac: *)\w+/\1Balanced/' \
        's/^(\s*platform_profile_on_battery: *)\w+/\1Quiet/'
    echo "asusd: Quiet on battery, Balanced plugged in"
    quiet_rcc
}

calm() {
    edit_asusd \
        's/^(\s*change_platform_profile_on_ac: *)\w+/\1false/' \
        's/^(\s*change_platform_profile_on_battery: *)\w+/\1false/'
    echo "asusd: the profile no longer changes on plug / unplug"
    quiet_rcc
}

# ---------------------------------------------------------------- GPU switching
# asusd switches the GPU itself since asusctl 6.3.9 (ROG Control's GPU
# page); supergfxctl, which did it before, is retired upstream and, left
# running, keeps asusd from doing it
retire_supergfx() {
    if pacman -Qq supergfxctl >/dev/null 2>&1 || systemctl cat supergfxd.service >/dev/null 2>&1; then
        echo ":: supergfxctl is retired (asusd switches the GPU now): removing it"
        sudo systemctl disable --now supergfxd.service 2>/dev/null || true
        pacman -Qq supergfxctl >/dev/null 2>&1 && { sudo pacman -Rns --noconfirm supergfxctl || echo "   (could not remove supergfxctl; see above)"; }
    fi
}

switch() {
    retire_supergfx
    local pkgs=()
    pacman -Qq asusctl >/dev/null 2>&1 || pkgs+=(asusctl)
    pacman -Qq rog-control-center >/dev/null 2>&1 || pkgs+=(rog-control-center)
    if ((${#pkgs[@]})); then sudo pacman -S --needed --noconfirm "${pkgs[@]}" || true; fi
    echo ":: asusd: restarted, to take the GPU over"
    sudo systemctl restart asusd.service || true
    if ! armoury >/dev/null; then
        echo "   this kernel ($(uname -r)) has no asus-armoury driver (Linux 6.19+):"
        echo "   ROG Control's GPU page needs it. Start the regular kernel (linux) from"
        echo "   the boot menu; then check with: archive-rog status"
    fi
    echo ":: done: log out and back in, then use ROG Control's GPU page"
}

# the firmware's GPU switches, where the kernel shows them: asus-armoury
# (Linux 6.19+), else the older asus-nb-wmi files
armoury() {
    local d=/sys/class/firmware-attributes/asus-armoury/attributes
    [[ -d $d ]] || return 1
    local a
    for a in gpu_mux_mode dgpu_disable egpu_enable; do
        [[ -r $d/$a/current_value ]] && printf '%s=%s ' "$a" "$(cat "$d/$a/current_value")"
    done
    echo
}

# ---------------------------------------------------------------- the dGPU
gpu() {
    # headers for every installed kernel (linux, linux-lts, linux-g14, ...)
    local pkgs=(nvidia-open-dkms nvidia-utils) k
    for k in /usr/lib/modules/*/pkgbase; do
        [[ -f $k ]] && pkgs+=("$(cat "$k")-headers")
    done
    echo ":: the NVIDIA driver and headers: ${pkgs[*]}"
    sudo pacman -S --needed --noconfirm "${pkgs[@]}" || sudo pacman -S --needed "${pkgs[@]}" || echo "   (see the error above)"
    sudo pacman -S --needed --noconfirm lib32-nvidia-utils 2>/dev/null || echo "   (lib32-nvidia-utils skipped: enable [multilib] for 32-bit games)"

    retire_supergfx

    echo ":: dGPU power: sleeps when unused, survives suspend"
    printf '%s\n' \
        "# archive-rog gpu: the dGPU powers off when nothing uses it, and keeps" \
        "# its memory across suspend" \
        "options nvidia NVreg_DynamicPowerManagement=0x02 NVreg_PreserveVideoMemoryAllocations=1" |
        sudo tee /etc/modprobe.d/nvidia-power.conf >/dev/null
    sudo systemctl enable nvidia-suspend.service nvidia-resume.service nvidia-hibernate.service 2>/dev/null || true

    suspend_mode --no-rebuild || true

    echo ":: rebuilding the driver and the boot images"
    sudo dkms autoinstall || true
    sudo mkinitcpio -P || echo "   (mkinitcpio reported a problem; see above)"

    echo ":: done: reboot, then check with: archive-rog status"
}

# suspend_mode [--no-rebuild]: the driver's own suspend (kernel notifiers)
# when it has it, else the systemd services with their console switch
suspend_mode() {
    local conf=/etc/modprobe.d/nvidia-power.conf ver major lic
    ver=$(modinfo -F version nvidia 2>/dev/null || true)
    if [[ -z $ver ]]; then
        echo "sleep: no NVIDIA driver installed; nothing to do"
        return 0
    fi
    major=${ver%%.*}
    lic=$(modinfo -F license nvidia 2>/dev/null || true)
    if (( major < 595 )) || [[ $lic != *GPL* && $lic != *MIT* ]]; then
        echo "sleep: NVIDIA $ver ($lic) suspends through its systemd services (595+ open modules can do without)"
        return 0
    fi
    if grep -q 'NVreg_UseKernelSuspendNotifiers=1' "$conf" 2>/dev/null \
        && ! systemctl is-enabled --quiet nvidia-suspend.service 2>/dev/null; then
        echo "sleep: already set (NVIDIA $ver suspends itself)"
        return 0
    fi
    echo ":: NVIDIA $ver suspends itself: no console switch on sleep and wake"
    printf '%s\n' \
        "# archive-rog: the dGPU powers off when nothing uses it; the driver" \
        "# suspends itself (keeping its memory), without the systemd services" \
        "# and their switch to a text console" \
        "options nvidia NVreg_DynamicPowerManagement=0x02 NVreg_UseKernelSuspendNotifiers=1" |
        sudo tee "$conf" >/dev/null
    sudo systemctl disable nvidia-suspend.service nvidia-resume.service nvidia-hibernate.service \
        nvidia-suspend-then-hibernate.service 2>/dev/null || true
    if [[ ${1:-} != --no-rebuild ]] && grep -Eq '^MODULES=.*nvidia' /etc/mkinitcpio.conf 2>/dev/null; then
        echo ":: the boot images carry the driver: rebuilding them"
        sudo mkinitcpio -P || echo "   (mkinitcpio reported a problem; see above)"
    fi
    echo ":: done: takes effect after a reboot"
}

status() {
    echo "kernel:      $(uname -r)"
    echo "nvidia:      $(lsmod | grep -q '^nvidia ' && echo loaded || echo 'NOT loaded')"
    local dev
    dev=$(lspci -D -d 10de: 2>/dev/null | grep -iE 'vga|3d' | cut -d' ' -f1 | head -n1 || true)
    if [[ -n $dev ]]; then
        echo "dGPU:        $dev, $(cat "/sys/bus/pci/devices/$dev/power/runtime_status" 2>/dev/null) (suspended = asleep, no power)"
    else
        echo "dGPU:        not on the bus (Integrated mode, or not found)"
    fi
    echo "asusctl:     $(pacman -Q asusctl 2>/dev/null | cut -d' ' -f2 || echo 'not installed'), asusd $(systemctl is-active asusd.service 2>/dev/null || true)"
    if pacman -Qq supergfxctl >/dev/null 2>&1; then
        echo "supergfxctl: still installed: it fights asusd; run: archive-rog switch"
    fi
    local fw
    if fw=$(armoury); then
        echo "switches:    asus-armoury: ${fw:-none shown}"
    else
        local w=/sys/devices/platform/asus-nb-wmi
        echo "switches:    no asus-armoury on this kernel (needs Linux 6.19+): ROG Control cannot switch the GPU"
        [[ -r $w/gpu_mux_mode ]] && echo "             (asus-nb-wmi: gpu_mux_mode=$(cat $w/gpu_mux_mode) dgpu_disable=$(cat $w/dgpu_disable 2>/dev/null))"
    fi
    echo "profile:     $(powerprofilesctl get 2>/dev/null || echo '?')"
    if grep -q 'NVreg_UseKernelSuspendNotifiers=1' /etc/modprobe.d/nvidia-power.conf 2>/dev/null; then
        echo "sleep:       the driver suspends itself (no console switch)"
    else
        echo "sleep:       through nvidia-suspend/resume (switches to a text console; see archive-rog sleep)"
    fi
    grep -E '^\s*(change_)?platform_profile_on_(ac|battery)' "$asusd_cfg" 2>/dev/null | sed 's/^\s*/asusd:       /' || true
}

case ${1:-status} in
    gpu) gpu ;;
    power) power ;;
    calm) calm ;;
    switch) switch ;;
    sleep) suspend_mode ;;
    status) status ;;
    *) echo "usage: archive-rog gpu|power|calm|switch|sleep|status" >&2; exit 2 ;;
esac
