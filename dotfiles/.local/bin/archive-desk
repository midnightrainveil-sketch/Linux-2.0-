#!/usr/bin/env bash
# archive-desk: lay the desk out as it was at login.
#
#   archive-desk            put everything back (the bar's desk button, Super+D)
#   archive-desk terminal   just the terminal
#   archive-desk lift       the desk terminal becomes an ordinary terminal
#                           window, all in it carried over (tmux, programs,
#                           what was typed), and a fresh one is laid on the
#                           desk (Super+Shift+D)
#   archive-desk dot        the title bar's green dot: on the desk terminal,
#                           lift it; on any other window, maximise and back
#
# The desk is the three record cards on the right and one live terminal on
# the left (the reference picture). Drag them around, close them, send the
# terminal to the drawer: this brings it all back. The cards return to their
# places; the terminal comes to the workspace you are on, floating, at its
# place and size (the pointer stays where it is). If it was closed, a new one opens (it
# greets you with fastfetch).
set -uo pipefail

# the terminal's place, as fractions of the screen, and its shape: 4:3 with
# its title bar (as in hypr/archive/rules.lua)
X=0.019 Y=0.25 W=0.328 BAR=46
# the desk card is smaller than a working terminal, so its type is too: the
# whole fastfetch card fits (other terminals keep foot.ini's 14.5 pt)
FONT="Courier Prime:size=10,IBM Plex Mono:size=10"

# desk terminals lifted into ordinary windows (their addresses), for this
# log-in; hypr/archive/rules.lua reads it too
released="${XDG_RUNTIME_DIR:-/tmp}/archive-desk-released"
opening="${XDG_RUNTIME_DIR:-/tmp}/archive-desk-opening"

# the desk terminal's window: [address, pid] (not one lifted already)
desk_window() {
    hyprctl clients -j | jq -r --rawfile gone <(cat "$released" 2>/dev/null || true) '
        [.[] | . as $w | select($w.class == "archive.desk" and ([$gone | split("\n")[] | select(. == $w.address)] | length == 0))][0]
        | if . == null then empty else "\(.address) \(.pid)" end'
}

open_terminal() {
    # one desk terminal: not again while one is still starting (5 s)
    if [[ -e $opening ]] && (( $(date +%s) - $(stat -c %Y "$opening") < 5 )); then return; fi
    touch "$opening"
    setsid -f foot --app-id=archive.desk \
        --override="main.font=$FONT" \
        --override="main.font-bold=Courier Prime:weight=Bold:size=10,IBM Plex Mono:weight=SemiBold:size=10" \
        --override="main.pad=16x10" \
        env ARCHIVE_DESK=1 zsh >/dev/null 2>&1
}

cards() {
    qs ipc call desk restore >/dev/null 2>&1 || true
}

terminal() {
    local addr pid
    read -r addr pid < <(desk_window) || true
    if [[ -z $addr ]]; then
        # rules.lua floats it and puts it in place
        open_terminal
        return
    fi

    local mon ws
    mon=$(hyprctl monitors -j | jq -c '.[] | select(.focused)')
    ws=$(jq -r '.activeWorkspace.id' <<<"$mon")
    # the monitor in layout coordinates (its size divided by its scale, turned if rotated)
    read -r mx my mw mh < <(jq -r '
        (.transform % 2 == 1) as $turned
        | [.x, .y, ((if $turned then .height else .width end) / .scale | floor), ((if $turned then .width else .height end) / .scale | floor)]
        | @tsv' <<<"$mon")
    local px py pw ph
    px=$(awk -v m="$mx" -v w="$mw" -v f="$X" 'BEGIN { printf "%d", m + w * f }')
    py=$(awk -v m="$my" -v h="$mh" -v f="$Y" 'BEGIN { printf "%d", m + h * f }')
    pw=$(awk -v w="$mw" -v f="$W" 'BEGIN { printf "%d", w * f }')
    ph=$(awk -v w="$mw" -v f="$W" -v bar="$BAR" 'BEGIN { printf "%d", w * f * 3 / 4 - bar }')

    local win="window = \"address:$addr\""
    hyprctl dispatch "hl.dsp.window.move({ workspace = \"$ws\", follow = false, $win })" >/dev/null
    hyprctl dispatch "hl.dsp.window.float({ action = \"on\", $win })" >/dev/null
    hyprctl dispatch "hl.dsp.window.resize({ x = $pw, y = $ph, $win })" >/dev/null
    hyprctl dispatch "hl.dsp.window.move({ x = $px, y = $py, $win })" >/dev/null
    # (not focused: focusing moves the pointer onto it, and focus follows the
    # pointer anyway; click the terminal to type)
}

# The desk terminal, lifted into an ordinary window: the same window, so
# all that runs in it stays. foot is told a new app-id (OSC 176, written
# to its terminal directly, so tmux or a program in front does not stand
# in the way): from then on Hyprland treats it as any terminal. It is tiled
# on the workspace you are on, its type brought up to a working
# terminal's (the desk's is smaller: 10 pt, then 9 steps of 0.5 pt to
# foot.ini's 14.5), and a fresh terminal is laid on the desk.
lift() {
    local addr pid shell tty
    read -r addr pid < <(desk_window) || true
    if [[ -z ${addr:-} ]]; then
        echo "no desk terminal to lift" >&2
        return 1
    fi
    shell=$(pgrep -o -P "$pid" || true)
    tty=$(readlink "/proc/${shell:-0}/fd/0" 2>/dev/null || true)
    [[ $tty == /dev/pts/* ]] && printf '\033]176;foot\033\\' >"$tty"
    echo "$addr" >>"$released"

    local ws win="window = \"address:$addr\""
    ws=$(hyprctl activeworkspace -j | jq -r '.id')
    hyprctl dispatch "hl.dsp.window.move({ workspace = \"$ws\", follow = false, $win })" >/dev/null
    hyprctl dispatch "hl.dsp.window.float({ action = \"off\", $win })" >/dev/null
    hyprctl dispatch "hl.dsp.focus({ $win })" >/dev/null
    sleep 0.25
    local keys=() i
    for i in 1 2 3 4 5 6 7 8 9; do keys+=(-k equal); done
    wtype -M ctrl "${keys[@]}" -m ctrl 2>/dev/null || true

    sleep 0.4
    open_terminal
}

# the green dot acts on the window it was clicked on (the focused one)
dot() {
    local cls addr
    read -r cls addr < <(hyprctl activewindow -j | jq -r '"\(.class) \(.address)"') || true
    if [[ ${cls:-} == archive.desk ]] && ! grep -qxF "${addr:-}" "$released" 2>/dev/null; then
        lift
    else
        hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = "maximized", action = "toggle" })' >/dev/null
    fi
}

case ${1:-all} in
    all | restore)
        cards
        terminal
        ;;
    terminal) terminal ;;
    cards) cards ;;
    lift) lift ;;
    dot) dot ;;
    *) echo "usage: archive-desk [all|terminal|cards|lift|dot]" >&2; exit 2 ;;
esac
