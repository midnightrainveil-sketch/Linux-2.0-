#!/usr/bin/env bash
# ultra-update: fetch the latest version of the desktop and install it.
#
#   ultra-update
#
# Downloads it from GitHub into a temporary folder and runs its setup.sh,
# which copies it over ~/ultra (the machine's part and every theme it
# ships; themes of your own are left alone), installs anything new and
# rebuilds the title-bar plugins if they changed. Reboot when it says so.
# ULTRA_REPO / ULTRA_BRANCH pick another source.
set -euo pipefail
repo=${ULTRA_REPO:-midnightrainveil-sketch/Linux-2.0-}
branch=${ULTRA_BRANCH:-claude/hyprland-ui-setup-l5njnw}

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
echo ":: downloading $repo ($branch)"
curl -fL "https://github.com/$repo/archive/refs/heads/$branch.tar.gz" | tar xz -C "$tmp" --strip-components=1
"$tmp/setup.sh" "$@"
