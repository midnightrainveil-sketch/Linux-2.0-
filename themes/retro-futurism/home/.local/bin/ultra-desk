#!/usr/bin/env bash
# ultra-desk: the terminal widget on the home screen.
#
#   ultra-desk          bring it to the workspace you are on, at its place
#                       and size; if it was closed, open it again (Super + D)
#   ultra-desk full     a fullscreen view of it (Super + F on the widget):
#                       another window onto the same shell, so whatever runs
#                       in it, its history and the screen carry over; the
#                       widget stays behind it, and closing the view goes
#                       back to the widget
#
# The widget floats in the picture's left third, 16:9: its right edge along
# the pole (the painting's own left third line), its middle on the lower
# third line, so that it balances her on the right third; untouched by
# Hyprland's tiling: while a tiled window is on the workspace it steps out
# of the way and comes back when the workspace is clear (hypr/theme/rules.lua).
# Its shell runs in a tmux session of its own (desk.tmux.conf: no status
# line, no prefix), which is what lets the views share it, and lets it live
# on when the widget is closed: opening it again picks it up.
set -uo pipefail

# its place and size: fractions of the screen's width (so 16:9 on any
# screen) and height (as in hypr/theme/rules.lua)
X=0.0198 Y=0.5375 W=0.2875 H=0.16172
conf="${XDG_CONFIG_HOME:-$HOME/.config}/ultra/retro-futurism/desk.tmux.conf"
session=(tmux -L ultra-desk -f "$conf")
attach=("${session[@]}" new-session -A -s desk -e ULTRA_DESK=1 zsh)
opening="${XDG_RUNTIME_DIR:-/tmp}/ultra-desk-opening"

clients() { hyprctl clients -j 2>/dev/null; }
address_of() {   # address_of <class>: the newest window of that class
    clients | jq -r --arg c "$1" '[.[] | select(.class == $c)] | sort_by(.focusHistoryID) | .[0].address // empty'
}
once() {   # once <name>: not again while one is still starting (5 s)
    local f="$opening-$1"
    if [[ -e $f ]] && (( $(date +%s) - $(stat -c %Y "$f") < 5 )); then return 1; fi
    touch "$f"
}
ghostty_with() {   # ghostty_with <class> <font size> <padding x> <padding y> <command...>
    local class=$1 size=$2 px=$3 py=$4; shift 4
    if command -v tmux >/dev/null; then
        setsid -f ghostty --class="$class" --gtk-single-instance=false \
            --font-size="$size" --window-padding-x="$px" --window-padding-y="$py" \
            -e "$@" >/dev/null 2>&1
    else
        # (no tmux: a plain shell; the fullscreen view then opens a new one)
        setsid -f ghostty --class="$class" --gtk-single-instance=false \
            --font-size="$size" --window-padding-x="$px" --window-padding-y="$py" \
            -e env ULTRA_DESK=1 zsh >/dev/null 2>&1
    fi
}

if [[ ${1:-} == full ]]; then
    once full || exit 0
    ghostty_with retro-futurism.desk-view 14 24 18 "${attach[@]}"
    # fullscreen as soon as it is up and in focus
    for _ in $(seq 40); do
        a=$(clients | jq -r '[.[] | select(.class == "retro-futurism.desk-view")] | sort_by(.focusHistoryID) | .[0] | select(.focusHistoryID == 0) | .address // empty')
        if [[ -n $a ]]; then
            hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = "fullscreen", action = "toggle" })' >/dev/null
            exit 0
        fi
        sleep 0.1
    done
    exit 0
fi

addr=$(address_of retro-futurism.desk) || true
if [[ -z ${addr:-} ]]; then
    once desk && ghostty_with retro-futurism.desk 10 14 10 "${attach[@]}"   # rules.lua floats it and puts it in place
    exit 0
fi

mon=$(hyprctl monitors -j | jq -c '.[] | select(.focused)')
ws=$(jq -r '.activeWorkspace.id' <<<"$mon")
# the monitor in layout coordinates (its size divided by its scale, turned if rotated)
read -r mx my mw mh < <(jq -r '
    (.transform % 2 == 1) as $turned
    | [.x, .y, ((if $turned then .height else .width end) / .scale | floor), ((if $turned then .width else .height end) / .scale | floor)]
    | @tsv' <<<"$mon")
px=$(awk -v m="$mx" -v w="$mw" -v f="$X" 'BEGIN { printf "%d", m + w * f }')
py=$(awk -v m="$my" -v h="$mh" -v f="$Y" 'BEGIN { printf "%d", m + h * f }')
pw=$(awk -v w="$mw" -v f="$W" 'BEGIN { printf "%d", w * f }')
ph=$(awk -v w="$mw" -v f="$H" 'BEGIN { printf "%d", w * f }')

win="window = \"address:$addr\""
hyprctl dispatch "hl.dsp.window.move({ workspace = \"$ws\", follow = false, $win })" >/dev/null
hyprctl dispatch "hl.dsp.window.float({ action = \"on\", $win })" >/dev/null
hyprctl dispatch "hl.dsp.window.resize({ x = $pw, y = $ph, $win })" >/dev/null
hyprctl dispatch "hl.dsp.window.move({ x = $px, y = $py, $win })" >/dev/null
