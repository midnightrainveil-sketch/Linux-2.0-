#!/usr/bin/env bash
# ultra-look: this theme's look for programs, set as the session starts:
# light (day), Magnetic 88's cream and rust; websites and apps asked for light. (GTK reads gtk.css from ~/.config/gtk-3.0
# and gtk-4.0; they are written here, and taken away when another theme
# comes: theme.json "leaves".)
set -u
config="${XDG_CONFIG_HOME:-$HOME/.config}"
css="$config/ultra/retro-futurism/gtk.css"
if [[ -f $css ]]; then
    for d in gtk-3.0 gtk-4.0; do
        mkdir -p "$config/$d"
        cmp -s "$css" "$config/$d/gtk.css" || cp -f "$css" "$config/$d/gtk.css"
    done
fi
fc-cache >/dev/null 2>&1 &
if command -v gsettings >/dev/null; then
    i=org.gnome.desktop.interface
    gsettings set $i color-scheme prefer-light
    gsettings set $i gtk-theme adw-gtk3
    gsettings set $i icon-theme Papirus
    gsettings set $i font-name 'JetBrains Mono 10'
    gsettings set $i monospace-font-name 'JetBrains Mono 11'
    # the theme's cursors, at its size ("cursorSize" in its settings.json)
    size=$(grep -o '"cursorSize"[[:space:]]*:[[:space:]]*[0-9]*' "$config/ultra/retro-futurism/settings.json" 2>/dev/null | grep -o '[0-9]*$')
    gsettings set $i cursor-theme Magnetic88
    gsettings set $i cursor-size "${size:-28}"
    gsettings set org.gnome.desktop.wm.preferences button-layout ':'
    gsettings set org.gnome.desktop.sound theme-name freedesktop     # (no sounds of its own: not another theme's)
fi 2>/dev/null
wait
