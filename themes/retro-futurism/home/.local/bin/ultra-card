#!/usr/bin/env bash
# ultra-card: the terminal's greeting. A picture at the left, borderless
# (card-art.txt: any image, drawn by tools/make_card_art.py; the Arch logo
# until then), and one box beside it: who and where in its top edge, the
# time at its right; the machine in five lines; a rule; three gauges; the
# date and the theme's name in its bottom edge.
#
# It reads the machine itself (no fastfetch: quicker, and the same on every
# version) and fits the window: the picture and the box from 72 columns,
# the box alone below that, three lines in it for the small desk terminal.
# zsh runs it as a terminal opens; `ff` does too.
#
#   ultra-card
#   ULTRA_CARD_COLS=60 ultra-card    as if the window were that wide
set -u
shopt -s extglob
export LC_ALL="${LC_ALL:-C.UTF-8}"      # (character counts, not bytes)

cols=${ULTRA_CARD_COLS:-$(tput cols 2>/dev/null || echo 80)}
art_file="${XDG_DATA_HOME:-$HOME/.local/share}/ultra/retro-futurism/card-art.txt"

# ---- inks (the terminal's palette): bold, faint, indigo, rust
B=$'\e[1m' F=$'\e[90m' I=$'\e[34m' R=$'\e[31m' N=$'\e[0m'

# ---- the machine
user=${USER:-$(id -un)}
host=$(cat /etc/hostname 2>/dev/null || uname -n); host=${host%%$'\n'*}
os=$(. /etc/os-release 2>/dev/null; echo "${NAME:-Linux}")
kernel=$(uname -r)
desktop=${XDG_CURRENT_DESKTOP:-tty}
shell_name=$(basename "${SHELL:-sh}")
shell_ver=$("$shell_name" --version 2>/dev/null | head -n1 | grep -oE '[0-9]+(\.[0-9]+)+' | head -n1)
read -r up _ </proc/uptime; up=${up%.*}
if (( up >= 86400 )); then uptime="$((up / 86400))d $((up % 86400 / 3600))h"
elif (( up >= 3600 )); then uptime="$((up / 3600))h $((up % 3600 / 60))m"
else uptime="$((up / 60))m"; fi
mem_total=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
mem_used=$(( mem_total - $(awk '/^MemAvailable:/ {print $2}' /proc/meminfo) ))
read -r disk_total disk_used < <(df -B1 --output=size,used / 2>/dev/null | tail -n1)
bat="" bat_state=""
for b in /sys/class/power_supply/BAT*; do
    [[ -r $b/capacity ]] || continue
    bat=$(<"$b/capacity"); bat_state=$(<"$b/status"); break
done

# ---- drawing
rep() { local s="" n=$2; while (( n-- > 0 )); do s+=$1; done; printf '%s' "$s"; }
vis() { local s=${1//$'\e['*([0-9;])m/}; echo "${#s}"; }          # its width, inks left out
fit() { local s=$1 n=$2; (( n < 1 )) && return; (( ${#s} > n )) && s="${s:0:n-1}…"; printf '%s' "$s"; }
pad() { local s=$1 n=$2; printf '%s%s' "$s" "$(rep ' ' $((n - $(vis "$s"))))"; }
pct() { (( $2 > 0 )) && echo $(( $1 * 100 / $2 )) || echo 0; }
# a gauge: n cells of heavy line, ink as far as p percent, faint after
gauge() {
    local p=$1 n=$2 warn=${3:-0} f ink=""
    f=$(( (p * n + 50) / 100 )); (( f > n )) && f=$n
    (( warn )) && ink=$R
    printf '%s%s%s%s%s' "$ink" "$(rep '━' "$f")" "$F" "$(rep '━' $((n - f)))" "$N"
}
# an edge of the box, words set into it at both ends:  ╭─ left ─────── right ─╮
edge() {    # edge <width> <left corner> <right corner> <left words> <right words>
    local w=$1 lc=$2 rc=$3 l=$4 r=$5 fill
    fill=$(( w - 2 - 2 - $(vis "$l") - 2 - $(vis "$r") - 2 ))
    [[ -z $l ]] && fill=$(( fill + 3 ))
    [[ -z $r ]] && fill=$(( fill + 3 ))
    printf '%s%s─%s' "$F" "$lc" "$N"
    [[ -n $l ]] && printf ' %s %s' "$l" ""
    printf '%s%s%s' "$F" "$(rep '─' "$fill")" "$N"
    [[ -n $r ]] && printf ' %s ' "$r"
    printf '%s─%s%s' "$F" "$rc" "$N"
}

mem_p=$(pct "$mem_used" "$mem_total")
disk_p=$(pct "${disk_used:-0}" "${disk_total:-0}")
bat_low=0; [[ -n $bat && $bat_state != Charging ]] && (( bat <= 15 )) && bat_low=1
bat_mark=""; [[ $bat_state == Charging ]] && bat_mark=" ↑"

# the box, `w` wide, into the array BOX
make_box() {
    local w=$1 small=${2:-0} inner kw=9 vw g rows=() r
    inner=$(( w - 4 ))
    vw=$(( inner - kw ))
    kv() { printf '%s%s%s%s' "$F" "$(pad "$1" "$kw")" "$N" "$(fit "$2" "$vw")"; }
    meter() {    # meter <key> <percent> <warn> <mark>
        local tail="$B$2%$N$4"
        g=$(( inner - 6 - 6 ))
        printf '%s%s%s%s%s%s' "$F" "$(pad "$1" 6)" "$N" "$(gauge "$2" "$g" "$3")" \
            "$(rep ' ' $(( inner - 6 - g - $(vis "$tail") )))" "$tail"
    }
    BOX=("$(edge "$w" ╭ ╮ "$B$user$N$F @ $N$B$host$N" "$B$(date +%H:%M)$N")")
    if (( ! small )); then
        rows+=("$(kv system "$os")" "$(kv kernel "$kernel")" "$(kv desktop "$desktop")"
               "$(kv shell "$shell_name${shell_ver:+ $shell_ver}")" "$(kv awake "$uptime")" "-")
        rows+=("$(meter mem "$mem_p" $(( mem_p >= 90 )) "")" "$(meter disk "$disk_p" $(( disk_p >= 90 )) "")")
    else
        rows+=("$(meter mem "$mem_p" $(( mem_p >= 90 )) "")")
    fi
    [[ -n $bat ]] && rows+=("$(meter bat "$bat" "$bat_low" "$bat_mark")")
    for r in "${rows[@]}"; do
        if [[ $r == - ]]; then BOX+=("$F├$(rep '─' $((w - 2)))┤$N"); continue; fi
        BOX+=("$F│$N $(pad "$r" "$inner") $F│$N")
    done
    if (( small )); then
        BOX+=("$F╰$(rep '─' $((w - 2)))╯$N")
    else
        BOX+=("$(edge "$w" ╰ ╯ "$F$(date '+%a %-d %b' | tr '[:lower:]' '[:upper:]')$N" "${F}MAGNETIC 88$N")")
    fi
}

art=()
[[ -r $art_file ]] && mapfile -t art <"$art_file"
art_w=0
for l in "${art[@]}"; do (( ${#l} > art_w )) && art_w=${#l}; done

printf '\n'
if (( art_w > 0 && cols >= art_w + 4 + 4 + 44 )); then
    # the picture, then the box beside it, both centred on each other
    w=$(( cols - 2 - art_w - 4 - 2 )); (( w > 50 )) && w=50
    make_box "$w"
    n=${#BOX[@]}; (( ${#art[@]} > n )) && n=${#art[@]}
    ao=$(( (n - ${#art[@]}) / 2 )); bo=$(( (n - ${#BOX[@]}) / 2 ))
    for (( r = 0; r < n; r++ )); do
        a=""; (( r >= ao && r - ao < ${#art[@]} )) && a=${art[r - ao]}
        bx=""; (( r >= bo && r - bo < ${#BOX[@]} )) && bx=${BOX[r - bo]}
        printf '  %s%s%s    %s\n' "$I" "$(pad "$a" "$art_w")" "$N" "$bx"
    done
elif (( cols >= 40 )); then
    w=$(( cols - 4 )); (( w > 56 )) && w=56
    make_box "$w"
    printf '  %s\n' "${BOX[@]}"
else
    w=$(( cols - 4 )); (( w < 24 )) && w=24
    make_box "$w" 1
    printf '  %s\n' "${BOX[@]}"
fi
printf '\n'
