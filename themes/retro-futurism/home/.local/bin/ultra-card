#!/usr/bin/env python3
# ultra-card: the terminal's greeting, in black and white, each fact with its
# icon (Nerd Font symbols, which Ghostty carries): a picture, borderless (the
# card-art folder: tools/make_card_art.py), and the machine in boxes titled
# in their top edges.
#
# Hyprland tiles terminals by halving the newest one, so a terminal can be
# anything from the whole screen to a sliver. The card has a layout for each
# and takes the richest that fits both the width and the height, leaving the
# prompt room (on the G14, 1920 x 1200, Ghostty at 14 pt):
#
#   wide      1 terminal (160 x 40): the picture large, beside it the
#             header, the system and the session side by side, the resources
#   classic   2 (77 x 40): the header; the picture, the system over the
#             session; the resources
#   panel     3 (77 x 19), the terminal widget (65 x 15): the picture,
#             beside it the header (when tall enough), the machine and the
#             resources stacked
#   compact   (shorter): the header; a small picture, the system and the
#             session side by side; the resources
#   column    4 (35 x 18): the picture on top, one box under it
#   strip     5 (35 x 8): the picture and one small box side by side, as
#             many facts as the height allows
#   tiny      6 and on (14 x 8, 14 x 3): the picture and the time, or the time
#
# The picture: where the terminal shows real pictures (Ghostty, kitty) the
# drawing itself, placed over cells the card leaves free; in tmux under
# Ghostty (the terminal widget) the same through kitty's Unicode
# placeholders (cells tmux keeps like any text, each naming its piece of the
# picture); anywhere else (over SSH, other terminals) quadrant blocks.
#
# Quick, as a greeting must be: one process, the slow facts (the shell's
# version, the network) kept a while in $XDG_RUNTIME_DIR.
#
#   ultra-card
#   ultra-card --redraw           drawn over the screen in place, from its top
#                                 (zsh, on a resize: no blank moment between)
#   ultra-card --send-art <tty>   give that terminal the picture again (tmux
#                                 runs it as a view attaches: desk.tmux.conf)
#   ULTRA_CARD_COLS=60 ULTRA_CARD_ROWS=20 ultra-card    as if it were that size
#   ULTRA_CARD_BLOCKS=1 ultra-card                      blocks, not the picture
import base64, json, os, re, shutil, subprocess, sys, time

ENV = os.environ
HOME = ENV.get('HOME', '')
DATA = ENV.get('XDG_DATA_HOME') or os.path.join(HOME, '.local/share')
ART = os.path.join(DATA, 'ultra/retro-futurism/card-art')
RUN = ENV.get('XDG_RUNTIME_DIR') or '/tmp'
ART_STATE = os.path.join(RUN, 'ultra-card-art')
FACTS = os.path.join(RUN, 'ultra-card-facts.json')

B, F, N = '\x1b[1m', '\x1b[90m', '\x1b[0m'      # black and white only
LIGHT = '\x1b[37m'
PH = '\U0010eeee'                                # kitty's placeholder cell
DIAC = ('̅̍̎̐̒̽̾̿͆͊͋͌͐͑͒͗'
        '͛ͣͤͥͦͧͨͩͪͫͬͭͮͯ҃҄'
        '҅҆҇֒֓֔֕֗֘֙֜֝֞֟֠֡'
        '֨֩֫֬֯ׄؐؑؒؓؔؕؖؗٗ٘')

def run(cmd, timeout=0.6):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except Exception:
        return ''

def read(path, default=''):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default

def art_apc(c, r):
    """the picture for a placeholder grid c x r: transmitted with a virtual
    placement (image 88), its cells coloured 88 to name it"""
    path = base64.b64encode(os.path.realpath(os.path.join(ART, 'picture.png')).encode()).decode()
    return f'\x1b_Ga=T,U=1,i=88,f=100,t=f,q=2,c={c},r={r};{path}\x1b\\'

# (tmux, as a view attaches: straight to that terminal, the size the card
# last used)
if len(sys.argv) > 2 and sys.argv[1] == '--send-art':
    try:
        c, r = read(ART_STATE).split()
        if os.path.exists(os.path.join(ART, 'picture.png')):
            with open(sys.argv[2], 'w') as t:
                t.write(art_apc(c, r))
    except Exception:
        pass
    sys.exit(0)
REDRAW = '--redraw' in sys.argv[1:]

# ---- the size
try:
    tc, tr = os.get_terminal_size(sys.stdout.fileno())
except OSError:
    tc, tr = shutil.get_terminal_size((80, 24))
COLS = int(ENV.get('ULTRA_CARD_COLS') or tc)
ROWS = int(ENV.get('ULTRA_CARD_ROWS') or tr)
HMAX = ROWS - 3                     # a blank line above and below, and the prompt

# ---- the machine
def cpu_name():
    for line in read('/proc/cpuinfo').splitlines():
        if line.startswith('model name'):
            n = line.split(':', 1)[1]
            n = re.sub(r'\((R|TM|tm)\)|\bCPU\b|\bProcessor\b|@.*$|\s+w/.*$|\s+with .*$|\d+-Core', '', n)
            return re.sub(r'\s+', ' ', n).strip()
    return os.uname().machine

def gpu_names():
    """the graphics cards, the separate one first: "NVIDIA RTX 4060 Max-Q", "AMD Radeon 780M" ..."""
    out = []
    for line in run(['lspci', '-mm'], 1.5).splitlines():
        f = re.findall(r'"([^"]*)"', line)
        if len(f) < 3 or not re.search(r'VGA|3D|Display', f[0]):
            continue
        vendor, dev = f[1], f[2]
        v = ('NVIDIA' if 'NVIDIA' in vendor else 'AMD' if re.search('AMD|ATI', vendor)
             else 'Intel' if 'Intel' in vendor else vendor.split()[0])
        m = re.search(r'\[([^\]]+)\]', dev)
        name = m.group(1) if m else dev
        name = name.split('/')[0].strip()
        name = re.sub(r'\s*(Laptop GPU|Mobile)\s*$', '', name).strip()
        if v == 'AMD' and not m and re.match(r'(Phoenix|Rembrandt|Cezanne|Renoir|Barcelo|Hawk|Strix|Raphael|Granite)', dev):
            name = 'Radeon (integrated)'
        full = name if name.lower().startswith(v.lower()) else v + ' ' + name
        out.append((0 if v == 'NVIDIA' or ('Radeon RX' in full) else 1, full))
    return [n for _, n in sorted(out)]

def facts_cached():
    """what changes seldom, kept: the shell's version for the boot, the
    network a few seconds"""
    boot = read('/proc/sys/kernel/random/boot_id')
    try:
        with open(FACTS) as f:
            c = json.load(f)
    except Exception:
        c = {}
    if c.get('boot') != boot:
        c = {'boot': boot}
    shell = os.path.basename(ENV.get('SHELL', 'sh'))
    if c.get('shell') != shell:
        m = re.search(r'\d+(\.\d+)+', run([shell, '--version']).split('\n')[0])
        c['shell'], c['shell_ver'] = shell, (m.group(0) if m else '')
    if 'cpu' not in c:
        c['cpu'], c['cores'] = cpu_name(), os.cpu_count() or 0
    if 'gpus' not in c:
        c['gpus'] = gpu_names()
    if time.time() - c.get('net_at', 0) > 20:
        net = ''
        if shutil.which('nmcli'):
            for line in run(['nmcli', '-t', '-f', 'NAME,TYPE', 'connection', 'show', '--active'], 0.5).splitlines():
                name, _, kind = line.rpartition(':')
                if name and not re.search('loopback|bridge|tun|wireguard', kind):
                    net = name.replace('\\:', ':'); break
        c['net'], c['net_at'] = net, time.time()
    try:
        with open(FACTS + '.new', 'w') as f:
            json.dump(c, f)
        os.replace(FACTS + '.new', FACTS)
    except OSError:
        pass
    return c

cache = facts_cached()
user = ENV.get('USER') or run(['id', '-un']).strip()
host = (read('/etc/hostname') or os.uname().nodename).split('\n')[0]
osname = 'Linux'
for line in read('/etc/os-release').splitlines():
    if line.startswith('NAME='):
        osname = line[5:].strip('"'); break
kernel = os.uname().release
if os.path.isdir('/var/lib/pacman/local'):
    pkgs = str(sum(1 for d in os.scandir('/var/lib/pacman/local') if d.is_dir()))
elif os.path.exists('/var/lib/dpkg/status'):
    with open('/var/lib/dpkg/status', errors='replace') as f:
        pkgs = str(sum(1 for l in f if l.startswith('Package: ')))
else:
    pkgs = '?'
desktop = ENV.get('XDG_CURRENT_DESKTOP') or 'tty'
shell_name, shell_ver = cache['shell'], cache['shell_ver']
up = int(float(read('/proc/uptime', '0').split()[0]))
uptime = (f'{up // 86400}d {up % 86400 // 3600}h' if up >= 86400 else
          f'{up // 3600}h {up % 3600 // 60}m' if up >= 3600 else f'{up // 60}m')
mi = {}
for line in read('/proc/meminfo').splitlines():
    k, _, v = line.partition(':'); mi[k] = int(v.split()[0]) if v.split() else 0
mem_total = mi.get('MemTotal', 0); mem_used = mem_total - mi.get('MemAvailable', 0)
try:
    st = os.statvfs('/')
    disk_total = st.f_blocks * st.f_frsize; disk_used = (st.f_blocks - st.f_bfree) * st.f_frsize
except OSError:
    disk_total = disk_used = 0
bat = bat_state = ''
try:
    for b in sorted(os.listdir('/sys/class/power_supply')):
        p = f'/sys/class/power_supply/{b}'
        if b.startswith('BAT') and os.path.exists(p + '/capacity'):
            bat, bat_state = read(p + '/capacity'), read(p + '/status'); break
except OSError:
    pass
net = cache.get('net', '')
cpu, cores = cache.get('cpu', ''), cache.get('cores', 0)
gpus = cache.get('gpus', [])
now_day = time.strftime('%a ') + str(int(time.strftime('%d'))) + time.strftime(' %b')
now_day = now_day.upper()
now_time = time.strftime('%H:%M')

# ---- icons (Nerd Font symbols)
ic_user, ic_cal, ic_clock, ic_tape = '', '', '', '\U000f09d4'
ic_os = '' if osname.startswith('Arch') else ''
ic_kernel, ic_pkgs, ic_desk, ic_shell, ic_up = '', '', '', '', '\U000f0150'
ic_mem, ic_disk, ic_wifi = '\U000f035b', '\U000f02ca', '\U000f05a9'
ic_cpu, ic_gpu = '\U000f0ee0', '\U000f08ae'
ic_bat = '\U000f0084' if bat_state == 'Charging' else '\U000f0079'

# ---- drawing
_sgr = re.compile(r'\x1b\[[0-9;]*m')
_apc = re.compile(r'\x1b_G[^\x1b]*\x1b\\')
_fwd = re.compile(r'\x1b\[(\d+)C')
_diac = set(DIAC)

def vis(s):
    """its width on screen: inks and a picture's placing left out, a cursor
    step forward counted as the cells it steps over"""
    s = _apc.sub('', _sgr.sub('', s))
    n = sum(int(m) for m in _fwd.findall(s))
    s = _fwd.sub('', s)
    return len(s) - sum(1 for ch in s if ch in _diac) + n

def fit(s, n):
    if n < 1: return ''
    return s if len(s) <= n else s[:n - 1] + '…'

def pad(s, n): return s + ' ' * max(0, n - vis(s))

def gib(b):
    v = b / 1073741824
    return f'{v:.0f}' if v >= 100 else f'{v:.1f}'

def pct(a, b): return a * 100 // b if b > 0 else 0

def gauge(p, n, warn):
    f = min(n, (p * n + 50) // 100)
    return (B if warn else '') + '▆' * f + LIGHT + '▆' * (n - f) + N

mem_p = pct(mem_used, mem_total)
disk_p = pct(disk_used, disk_total)
mem_warn, disk_warn = mem_p >= 90, disk_p >= 90
bat_warn = bool(bat) and bat_state != 'Charging' and int(bat or 0) <= 15
bat_word = {'Charging': 'charging', 'Full': 'full', 'Discharging': 'on battery'}.get(bat_state, '')

def box(title, w, lines):
    """a box, its title in its top edge; a line "-" is a rule across it"""
    out = [f'{F}┏━{N} {B}{title}{N} {F}' + '━' * (w - 5 - len(title)) + f'┓{N}' if title
           else F + '┏' + '━' * (w - 2) + '┓' + N]
    for line in lines:
        out.append(F + '┣' + '━' * (w - 2) + '┫' + N if line == '-' else f'{F}┃{N} {pad(line, w - 4)} {F}┃{N}')
    out.append(F + '┗' + '━' * (w - 2) + '┛' + N)
    return out

def edge(w, cl, cr, l, r):
    """a box's edge with words set into it at both ends"""
    fill = w - 4 - 2 - vis(l) - 2 - vis(r) + (2 if not l else 0) + (2 if not r else 0)
    s = f'{F}{cl}━{N}' + (f' {l} ' if l else '') + F + '━' * fill + N + (f' {r} ' if r else '') + f'{F}━{cr}{N}'
    return s

def side(*cols):
    """columns side by side, a column apart, each kept to its width"""
    rows = max(len(c) for c in cols)
    out = []
    for r in range(rows):
        out.append('  ' + ' '.join(pad(c[r] if r < len(c) else '', vis(c[0])) for c in cols))
    return out

KW = 10
def kv(icon, key, value):
    return f'{icon}  {F}{pad(key, KW)}{N}{value}' if KW else f'{icon}  {value}'

def fact(name, vw):
    return {
        'os': lambda: kv(ic_os, 'os', fit(osname, vw)),
        'kernel': lambda: kv(ic_kernel, 'kernel', fit(kernel, vw)),
        'packages': lambda: kv(ic_pkgs, 'packages', pkgs),
        'desktop': lambda: kv(ic_desk, 'desktop', fit(desktop, vw)),
        'shell': lambda: kv(ic_shell, 'shell', fit(shell_name + (' ' + shell_ver if shell_ver else ''), vw)),
        'uptime': lambda: kv(ic_up, 'uptime', uptime),
        'network': lambda: kv(ic_wifi, 'network', fit(net or 'offline', vw)),
        'cpu': lambda: kv(ic_cpu, 'cpu', fit(cpu, vw) + (f'{F}  ·  {cores} threads{N}' if cores and len(cpu) + 14 <= vw else '')),
        'gpu': lambda: kv(ic_gpu, 'graphics', fit(gpus[0] if gpus else 'none found', vw)),
        'gpu2': lambda: kv(' ', '', fit(gpus[1], vw)) if len(gpus) > 1 else '',
    }[name]()

def meter(name, inner, figs):
    if name == 'memory':
        icon, key, p, warn = ic_mem, 'memory', mem_p, mem_warn
        text = f'{gib(mem_used * 1024)} / {gib(mem_total * 1024)} GiB'
    elif name == 'storage':
        icon, key, p, warn = ic_disk, 'storage', disk_p, disk_warn
        text = f'{gib(disk_used)} / {gib(disk_total)} GiB'
    else:
        icon, key, p, warn, text = ic_bat, 'battery', int(bat or 0), bat_warn, bat_word
    tail = f'{B}{p}%{N}'
    g = max(4, inner - 3 - KW - 2 - 18 - 5 if figs else inner - 3 - KW - 5)
    line = f'{icon}  ' + (F + pad(key, KW) + N if KW else '') + gauge(p, g, warn)
    if figs: line += f'  {F}{pad(text, 18)}{N}'
    return line + ' ' * (inner - vis(line) - vis(tail)) + tail

def meters(inner, figs, with_net):
    m = [meter('memory', inner, figs), meter('storage', inner, figs)]
    if bat: m.append(meter('battery', inner, figs))
    if with_net and net: m.append(fact('network', inner - 3 - KW))
    return m

def header(w):
    inner = w - 4
    left = f'{ic_tape}  {B}MAGNETIC 88{N}'
    right = f'{ic_user}  {B}{user}{N}{F} @ {N}{B}{host}{N}   {ic_cal}  {F}{now_day}{N}   {ic_clock}  {B}{now_time}{N}'
    if vis(left) + vis(right) + 2 > inner: right = f'{ic_cal}  {F}{now_day}{N}   {ic_clock}  {B}{now_time}{N}'
    if vis(left) + vis(right) + 2 > inner: right = f'{ic_clock}  {B}{now_time}{N}'
    return box('', w, [left + ' ' * (inner - vis(left) - vis(right)) + right])

# ---- the picture: `rows` lines tall, its width from its proportions
try:
    ratio = float(read(os.path.join(ART, 'ratio'), '1'))
except ValueError:
    ratio = 1.0
def pic_cols(r): return int(r * ratio / 0.42 + 0.5)

real = 0                            # 1: placed directly; 2: through tmux; 0: blocks
if not ENV.get('ULTRA_CARD_BLOCKS') and os.path.exists(os.path.join(ART, 'picture.png')) and not ENV.get('SSH_CONNECTION'):
    if ENV.get('TMUX'):
        if run(['tmux', 'display-message', '-p', '#{client_termname}']).strip() in ('xterm-ghostty', 'xterm-kitty'):
            real = 2
    elif ENV.get('TERM') in ('xterm-ghostty', 'xterm-kitty'):
        real = 1

PRE = []                            # sent before the card (the picture, through tmux)
def picture(rows):
    pw = pic_cols(rows)
    if real == 2:
        apc = art_apc(pw, rows)
        PRE.append('\x1bPtmux;' + apc.replace('\x1b', '\x1b\x1b') + '\x1b\\')
        try:
            with open(ART_STATE, 'w') as f: f.write(f'{pw} {rows}\n')
        except OSError:
            pass
        return pw, ['\x1b[38;5;88m' + ''.join(PH + DIAC[r] + DIAC[c] for c in range(pw)) + '\x1b[39m' for r in range(rows)]
    if real == 1:
        # placed at the first line's start, over cells the card steps over (the
        # cursor stays put: C=1; no answer back: q=2); the same image and
        # placement each time, so a redraw replaces it
        path = base64.b64encode(os.path.realpath(os.path.join(ART, 'picture.png')).encode()).decode()
        first = f'\x1b_Ga=T,i=89,p=1,f=100,t=f,C=1,q=2,c={pw},r={rows};{path}\x1b\\\x1b[{pw}C'
        return pw, [first] + [f'\x1b[{pw}C'] * (rows - 1)
    try:
        with open(os.path.join(ART, f'blocks-{rows}.txt')) as f:
            lines = f.read().rstrip('\n').split('\n')
        return pw, [pad(l, pw) for l in lines]
    except OSError:
        return pw, [' ' * pw] * rows

def blank(w, n): return [' ' * w] * n
def centred(col, pw, n):
    top = max(0, (n - len(col)) // 2)
    return blank(pw, top) + col

# ======================================================================
# the layouts, richest first; each gives its lines if it fits, else None

def lay_wide():
    if not (COLS >= 120 and HMAX >= 14): return None
    W = min(COLS - 4, 150)
    pw, pic = picture(14)
    RW = W - pw - 3
    if RW < 76: return None
    hw = (RW - 1) // 2; vw = hw - 4 - 3 - KW
    sys_ = box('SYSTEM', hw, [fact('os', vw), fact('kernel', vw), fact('gpu' if gpus else 'packages', vw)])
    ses = box('SESSION', RW - 1 - hw, [fact('desktop', vw), fact('shell', vw), fact('uptime', vw)])
    mid = [l[2:] for l in side(sys_, ses)]
    right = header(RW) + mid + box('RESOURCES', RW, meters(RW - 4, True, True))
    return side(pic, blank(1, len(right)), right)

def lay_classic():
    """the main look: the header across, the picture beside SYSTEM and
    SESSION, then the HARDWARE (its processor and graphics) and RESOURCES
    across; the hardware left out when the terminal is short"""
    if not (COLS >= 72 and HMAX >= 19): return None
    W = min(COLS - 4, 96)
    head = header(W)
    pr = 10 if HMAX >= 24 else 9
    pw, pic = picture(pr)
    RW = W - pw - 3; vw = RW - 4 - 3 - KW
    if RW < 32: return None
    right = (box('SYSTEM', RW, [fact('os', vw), fact('kernel', vw), fact('packages', vw)]) +
             box('SESSION', RW, [fact('desktop', vw), fact('shell', vw), fact('uptime', vw)]))
    left = blank(pw, max(0, (len(right) - pr) // 2)) + pic
    hw = []
    if HMAX >= 19 + 4 + (1 if len(gpus) > 1 else 0):
        wv = W - 4 - 3 - KW
        rows = [fact('cpu', wv)] + ([fact('gpu', wv)] if gpus else []) + ([fact('gpu2', wv)] if len(gpus) > 1 else [])
        hw = side(box('HARDWARE', W, rows))
    return side(head) + side(left, blank(1, len(right)), right) + hw + side(box('RESOURCES', W, meters(W - 4, True, True)))

def lay_panel():
    global KW
    if not (COLS >= 58 and HMAX >= 11): return None
    W = min(COLS - 4, 100)
    tall = HMAX >= 14                    # (short: no header box, the time in the machine box's edge)
    mn = 40 if tall else 34
    pr = min(HMAX - 2, 11); pw = pic_cols(pr)
    while W - pw - 3 < mn + 4 and pr > 5:
        pr -= 1; pw = pic_cols(pr)
    RW = W - pw - 3
    if RW < mn: return None
    vw = RW - 4 - 3 - KW
    names = (['os', 'kernel', 'gpu' if gpus else 'packages', 'desktop', 'shell', 'uptime'] if HMAX >= 18
             else ['os', 'kernel', 'desktop', 'uptime'])
    sys_ = box('MACHINE', RW, [fact(n, vw) for n in names])
    if tall:
        head = header(RW)
        sys_[0] = edge(RW, '┏', '┓', f'{ic_user}  {B}{fit(user, 16)}{N}{F} @ {N}{B}{fit(host, 16)}{N}', '')
    else:
        head = []
        sys_[0] = edge(RW, '┏', '┓', f'{B}{fit(user + "@" + host, RW - 16)}{N}', f'{ic_clock}  {B}{now_time}{N}')
    right = head + sys_ + box('RESOURCES', RW, meters(RW - 4, False, False))
    if len(right) > HMAX: return None
    pw, pic = picture(pr)
    return side(centred(pic, pw, len(right)), blank(2, len(right)), right)

def lay_compact():
    if not (COLS >= 64 and HMAX >= 13): return None
    W = min(COLS - 4, 90)
    head = header(W)
    pw = pic_cols(5)
    RW = W - pw - 2; hw = (RW - 1) // 2; vw = hw - 4 - 3 - KW
    if hw < 25: return None
    pw, pic = picture(5)
    sys_ = box('SYSTEM', hw, [fact('os', vw), fact('kernel', vw), fact('packages', vw)])
    ses = box('SESSION', RW - 1 - hw, [fact('desktop', vw), fact('shell', vw), fact('uptime', vw)])
    return side(head) + side(pic, sys_, ses) + side(box('RESOURCES', W, meters(W - 4, W >= 80, False)))

def lay_column():
    if not (COLS >= 30 and HMAX >= 14): return None
    W = min(COLS - 4, 44)
    pr = min(HMAX - 10, 7)
    if pr < 3: return None
    pw, pic = picture(pr)
    inner = W - 4; vw = W - 4 - 3 - KW
    out = ['  ' + ' ' * ((W - pw) // 2) + l for l in pic] + ['']
    one = box('', W, [fact('os', vw), fact('desktop', vw), fact('uptime', vw), '-'] + meters(inner, False, False))
    one[0] = edge(W, '┏', '┓', f'{B}{fit(user, W // 2 - 4)}{N}', f'{ic_clock}  {B}{now_time}{N}')
    one[-1] = edge(W, '┗', '┛', f'{F}{now_day}{N}', '')
    return out + side(one)

def lay_strip():
    global KW
    if not (COLS >= 26 and HMAX >= 5): return None
    KW = 0                               # no keys: the icons say what each is
    h = min(HMAX, 9); pr = h
    while True:
        pw = pic_cols(pr); BW = min(COLS - 4 - pw - 2, 30)
        if BW >= 18: break
        pr -= 1
        if pr < 3:
            pr = 0; pw = 0; BW = min(COLS - 4, 30); break
    inner = BW - 4; vw = BW - 4 - 3; n = h - 2
    m = meters(inner, False, False)
    allf = [('F', fact('os', vw)), ('G', m[0])]
    if bat: allf.append(('G', m[2]))
    allf += [('F', fact('uptime', vw)), ('F', fact('desktop', vw)), ('G', m[1])]
    facts = [l for k, l in allf[:n] if k == 'F']; gauges = [l for k, l in allf[:n] if k == 'G']
    lines = facts + (['-'] if n - len(facts) - len(gauges) >= 1 and facts and gauges else []) + gauges
    one = box('', BW, lines)
    one[0] = edge(BW, '┏', '┓', f'{B}{fit(user, BW - 14)}{N}', f'{B}{now_time}{N}')
    KW = 10
    if pr > 0:
        pw, pic = picture(pr)
        return side(centred(pic, pw, len(one)), blank(1, len(one)), one)
    return side(one)

def lay_tiny():
    pr = min(HMAX - 1, 5)
    while pr >= 3 and pic_cols(pr) > COLS - 4: pr -= 1
    out = []
    if pr >= 3:
        pw, pic = picture(pr)
        out = ['  ' + l for l in pic]
    return out + [f'  {ic_clock}  {B}{now_time}{N}']

for lay in (lay_classic, lay_wide, lay_panel, lay_compact, lay_column, lay_strip, lay_tiny):
    PRE.clear()
    lines = lay()
    if lines is not None: break

# in a terminal wider than any card (a fullscreen one), the card in the
# middle: every line moved over alike (the picture is placed where its
# line's cursor is, so it moves with them). Narrower ones, the desk's
# included, keep it at the left.
cw = max((vis(l) for l in lines), default=0) - 2          # (its own width, without the two-space margin)
shift = (COLS - cw) // 2 - 2 if COLS >= 110 else 0
if shift > 0:
    lines = [' ' * shift + l if l else l for l in lines]

body = [''] + lines + ['']
if REDRAW:
    # over the screen in place, from its top: each line cleared to its end,
    # the rest of the screen after it (and the history the reflow made)
    # (each line wholly cleared before it is written: the cells a picture is
    # laid over are stepped over, and the old card would show through it;
    # all of it one frame, so it does not flicker)
    out = ('\x1b[?2026h\x1b[3J\x1b[H' + ''.join(PRE) + ''.join('\x1b[2K' + l + '\n' for l in body)
           + '\x1b[J\x1b[?2026l')
else:
    out = ''.join(PRE) + '\n'.join(body) + '\n'
sys.stdout.write(out)
sys.stdout.flush()
