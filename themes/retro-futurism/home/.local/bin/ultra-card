#!/usr/bin/env bash
# ultra-card: the terminal's greeting, as boxed panels in black and white,
# the theme's e-ink, each fact with its icon (Nerd Font symbols: Ghostty
# carries them): a header (the name, who and where, the date and time); at
# the left, borderless, a picture (card-art.txt, drawn by
# tools/make_card_art.py: a smiling face until one is chosen); beside it
# the system and the session; and the resources as gauges.
#
# It reads the machine itself (no fastfetch: quicker, and the same on every
# version) and fits the window: every panel from 80 columns, without the
# picture from 56, two small panels below that (the desk terminal).
# zsh runs it as a terminal opens; `ff` does too.
#
#   ultra-card
#   ULTRA_CARD_COLS=60 ultra-card    as if the window were that wide
set -u
shopt -s extglob
export LC_ALL="${LC_ALL:-C.UTF-8}"      # (character counts, not bytes)

cols=${ULTRA_CARD_COLS:-$(tput cols 2>/dev/null || echo 80)}
(( cols > 86 )) && W=86 || W=$cols
W=$(( W - 2 ))                          # (the card is drawn two columns in)

# ---- inks: black and white only (bold, faint; a gauge's warning is bold)
B=$'\e[1m' F=$'\e[90m' I=$'\e[1m' R=$'\e[1m' N=$'\e[0m'
art_file="${XDG_DATA_HOME:-$HOME/.local/share}/ultra/retro-futurism/card-art.txt"

# ---- the machine
user=${USER:-$(id -un)}
host=$(cat /etc/hostname 2>/dev/null || uname -n); host=${host%%$'\n'*}
os=$(. /etc/os-release 2>/dev/null; echo "${NAME:-Linux}")
kernel=$(uname -r)
if command -v pacman >/dev/null; then pkgs=$(pacman -Qq 2>/dev/null | wc -l)
elif command -v dpkg-query >/dev/null; then pkgs=$(dpkg-query -f '.\n' -W 2>/dev/null | wc -l)
else pkgs="?"; fi
desktop=${XDG_CURRENT_DESKTOP:-tty}
shell_name=$(basename "${SHELL:-sh}")
shell_ver=$("$shell_name" --version 2>/dev/null | head -n1 | grep -oE '[0-9]+(\.[0-9]+)+' | head -n1)
read -r up _ </proc/uptime; up=${up%.*}
if (( up >= 86400 )); then uptime="$((up / 86400))d $((up % 86400 / 3600))h"
elif (( up >= 3600 )); then uptime="$((up / 3600))h $((up % 3600 / 60))m"
else uptime="$((up / 60))m"; fi

mem_total=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
mem_used=$(( mem_total - $(awk '/^MemAvailable:/ {print $2}' /proc/meminfo) ))
read -r disk_total disk_used < <(df -B1 --output=size,used / 2>/dev/null | tail -n1)
bat="" bat_state=""
for b in /sys/class/power_supply/BAT*; do
    [[ -r $b/capacity ]] || continue
    bat=$(<"$b/capacity"); bat_state=$(<"$b/status"); break
done
net=""
if command -v nmcli >/dev/null; then
    net=$(timeout 0.5 nmcli -t -f NAME,TYPE connection show --active 2>/dev/null \
          | awk -F: '$2 !~ /loopback|bridge|tun|wireguard/ {print $1; exit}')
fi

# ---- icons (Nerd Font symbols)
ic_user=$'\uf007' ic_cal=$'\uf073' ic_clock=$'\uf017' ic_tape=$'\U000f09d4'
ic_os=$'\uf17c'; [[ $os == Arch* ]] && ic_os=$'\uf303'
ic_kernel=$'\uf013' ic_pkgs=$'\uf487' ic_desk=$'\uf2d0' ic_shell=$'\uf489' ic_up=$'\U000f0150'
ic_mem=$'\U000f035b' ic_disk=$'\U000f02ca' ic_bat=$'\U000f0079' ic_wifi=$'\U000f05a9'
[[ ${bat_state:-} == Charging ]] && ic_bat=$'\U000f0084'

# ---- drawing
rep() { local s="" n=$2; while (( n-- > 0 )); do s+=$1; done; printf '%s' "$s"; }
vis() { local s=${1//$'\e['*([0-9;])m/}; echo "${#s}"; }          # its width, inks left out
fit() { local s=$1 n=$2; (( n < 1 )) && return; (( ${#s} > n )) && s="${s:0:n-1}…"; printf '%s' "$s"; }
pad() { local s=$1 n=$2; printf '%s%s' "$s" "$(rep ' ' $((n - $(vis "$s"))))"; }
gib() { awk -v b="$1" 'BEGIN { v = b / 1073741824; printf (v >= 100 ? "%.0f" : "%.1f"), v }'; }
pct() { (( $2 > 0 )) && echo $(( $1 * 100 / $2 )) || echo 0; }

# box <out array> <title> <width> <line>...: a rounded box, its title set
# in its top edge, each line padded to fill it
box() {
    local -n out=$1; local title=$2 w=$3 line top
    shift 3
    out=()
    if [[ -n $title ]]; then
        top="$F╭─$N $I$B$title$N $F$(rep '─' $((w - 5 - ${#title})))╮$N"
    else
        top="$F╭$(rep '─' $((w - 2)))╮$N"
    fi
    out+=("$top")
    for line in "$@"; do out+=("$F│$N $(pad "$line" $((w - 4))) $F│$N"); done
    out+=("$F╰$(rep '─' $((w - 2)))╯$N")
}
# side <boxes...> (names of arrays): print them side by side, a column apart,
# the shorter ones carried down with blank space their width
side() {
    local names=("$@") rows=0 r n line w
    for n in "${names[@]}"; do local -n a=$n; (( ${#a[@]} > rows )) && rows=${#a[@]}; done
    for (( r = 0; r < rows; r++ )); do
        line="  "
        for n in "${names[@]}"; do
            local -n a=$n
            w=$(vis "${a[0]}")
            line+="$(pad "${a[r]:-}" "$w") "
        done
        printf '%s\n' "${line% }"
    done
}
# a key and its value
kv() { printf '%s  %s%s%s%s' "$1" "$F" "$(pad "$2" 10)" "$N" "$3"; }      # kv <icon> <key> <value>
# a gauge: n cells of heavy line, ink as far as used/total, faint after
gauge() {
    local used=$1 total=$2 n=$3 warn=${4:-0} f ink=""
    (( total > 0 )) && f=$(( (used * n + total / 2) / total )) || f=0
    (( warn )) && ink=$R
    printf '%s%s%s%s%s' "$ink" "$(rep '━' "$f")" "$F" "$(rep '━' $((n - f)))" "$N"
}

now_day=$(date '+%a %-d %b' | tr '[:lower:]' '[:upper:]')
now_time=$(date '+%H:%M')
mem_p=$(pct "$mem_used" "$mem_total")
disk_p=$(pct "${disk_used:-0}" "${disk_total:-0}")
bat_low=0; [[ -n $bat && $bat_state != Charging ]] && (( bat <= 15 )) && bat_low=1
bat_word=""; case $bat_state in Charging) bat_word=charging ;; Full) bat_word=full ;; Discharging) bat_word="on battery" ;; esac

# the header: the name at the left, who, where and when at the right
header_box() {    # header_box <width>
    local w=$1 inner left right
    inner=$((w - 4))
    left="$ic_tape  ${B}MAGNETIC 88$N"
    right="$ic_user  $B$user$N$F @ $N$B$host$N   $ic_cal  $F$now_day$N   $ic_clock  $B$now_time$N"
    (( $(vis "$left") + $(vis "$right") + 2 > inner )) && right="$ic_cal  $F$now_day$N   $ic_clock  $B$now_time$N"
    (( $(vis "$left") + $(vis "$right") + 2 > inner )) && right="$ic_clock  $B$now_time$N"
    box HEAD "" "$w" "$left$(rep ' ' $((inner - $(vis "$left") - $(vis "$right"))))$right"
}
# the resources: a gauge each, its figures after it, the percentage at the end
resources_box() {   # resources_box <width>
    local w=$1 inner g rows=()
    inner=$((w - 4))
    g=$(( inner - 13 - 2 - 18 - 6 ))
    (( g > 34 )) && g=34
    (( g < 6 )) && g=6
    row() {   # row <key> <used> <total> <warn> <text> <percent> <icon>
        local t; t=$(fit "$5" 18)
        local line; line="$(kv "$7" "$1" "$(gauge "$2" "$3" "$g" "$4")")  $F$t$N"
        printf '%s%s%s' "$line" "$(rep ' ' $((inner - $(vis "$line") - ${#6})))" "$B$6$N"
    }
    rows+=("$(row memory "$mem_used" "$mem_total" $(( mem_p >= 90 )) "$(gib $((mem_used * 1024))) / $(gib $((mem_total * 1024))) GiB" "$mem_p%" "$ic_mem")")
    rows+=("$(row storage "${disk_used:-0}" "${disk_total:-0}" $(( disk_p >= 90 )) "$(gib "${disk_used:-0}") / $(gib "${disk_total:-0}") GiB" "$disk_p%" "$ic_disk")")
    [[ -n $bat ]] && rows+=("$(row battery "$bat" 100 "$bat_low" "$bat_word" "$bat%" "$ic_bat")")
    [[ -n $net ]] && rows+=("$(kv "$ic_wifi" network "$(fit "$net" $((inner - 13)))")")
    box RES RESOURCES "$w" "${rows[@]}"
}

printf '\n'
if (( W >= 78 )); then
    header_box "$W"; side HEAD
    # at the left, borderless: the cassette (or a picture of your own) and
    # what is playing; beside it the system and the session
    PIC=()
    [[ -r $art_file ]] && mapfile -t PIC <"$art_file"
    tw=0; for l in "${PIC[@]}"; do (( ${#l} > tw )) && tw=${#l}; done
    (( tw < 21 )) && tw=21
    for i in "${!PIC[@]}"; do PIC[i]="$(pad "${PIC[i]}" "$tw")"; done
    rw=$(( W - tw - 3 ))
    vw=$(( rw - 4 - 13 ))
    box SYS SYSTEM "$rw" "$(kv "$ic_os" os "$(fit "$os" $vw)")" "$(kv "$ic_kernel" kernel "$(fit "$kernel" $vw)")" "$(kv "$ic_pkgs" packages "$pkgs")"
    box SES SESSION "$rw" "$(kv "$ic_desk" desktop "$(fit "$desktop" $vw)")" "$(kv "$ic_shell" shell "$shell_name${shell_ver:+ $shell_ver}")" "$(kv "$ic_up" uptime "$uptime")"
    RIGHT=("${SYS[@]}" "${SES[@]}")
    n=${#RIGHT[@]}; top=$(( (n - ${#PIC[@]}) / 2 )); (( top < 0 )) && top=0
    LEFT=(); for (( r = 0; r < top; r++ )); do LEFT+=("$(rep ' ' "$tw")"); done
    LEFT+=("${PIC[@]}")
    for i in "${!LEFT[@]}"; do LEFT[i]="$(pad "${LEFT[i]}" $((tw + 2)))"; done
    side LEFT RIGHT
    resources_box "$W"; side RES
elif (( W >= 54 )); then
    header_box "$W"; side HEAD
    hw=$(( (W - 1) / 2 )); vw=$(( hw - 4 - 13 ))
    box SYS SYSTEM "$hw" "$(kv "$ic_os" os "$(fit "$os" $vw)")" "$(kv "$ic_kernel" kernel "$(fit "$kernel" $vw)")" "$(kv "$ic_pkgs" packages "$pkgs")"
    box SES SESSION "$(( W - 1 - hw ))" "$(kv "$ic_desk" desktop "$(fit "$desktop" $vw)")" "$(kv "$ic_shell" shell "$shell_name${shell_ver:+ $shell_ver}")" "$(kv "$ic_up" uptime "$uptime")"
    side SYS SES
    resources_box "$W"; side RES
else
    # narrow (the desk terminal): who and when, then the gauges
    box HEAD "" "$W" "$ic_user $B$(fit "$user@$host" $((W - 14)))$N$(rep ' ' $((W - 4 - 2 - $(vis "$(fit "$user@$host" $((W - 14)))") - 7)))$ic_clock $B$now_time$N"
    side HEAD
    g=$(( W - 4 - 3 - 5 )); (( g < 4 )) && g=4
    rows=("$ic_mem  $(gauge "$mem_used" "$mem_total" "$g" $(( mem_p >= 90 )))$(rep ' ' $((5 - ${#mem_p} - 1)))$B$mem_p%$N")
    [[ -n $bat ]] && rows+=("$ic_bat  $(gauge "$bat" 100 "$g" "$bat_low")$(rep ' ' $((5 - ${#bat} - 1)))$B$bat%$N")
    box RES "" "$W" "${rows[@]}"; side RES
fi
printf '\n'
