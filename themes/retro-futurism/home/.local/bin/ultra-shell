#!/usr/bin/env bash
# ultra-shell: run the shell (Quickshell), and start it again if it crashes.
#
#   ultra-shell        what Hyprland runs at login (one at a time)
#
# The bars, the film strip and every Super key that opens a panel (Super+Space
# ...) belong to the shell: if it crashed, they would all
# stay dead until the next login. Here a crash brings it back within a second.
# A deliberate stop (qs kill, pkill qs, ultra-wallpaper) is left alone, and
# after 5 crashes in 2 minutes it gives up rather than loop. Crashes are noted
# in ~/.local/state/ultra/retro-futurism/shell-crashes (Quickshell keeps its own report in
# ~/.cache/quickshell/crashes).
set -u
state="${XDG_STATE_HOME:-$HOME/.local/state}/ultra/retro-futurism"
mkdir -p "$state"
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/ultra-shell.lock"
flock -w 5 9 || exit 0        # one keeper is enough (a stopping one has 5 s to go)

# Memory the shell lets go of (a card closed, a picture dropped) goes back
# to the system: by default glibc keeps freed memory in one arena per thread
# and at the top of the heap, so the shell only ever grows.
export MALLOC_ARENA_MAX=2
export MALLOC_TRIM_THRESHOLD_=131072

# a screen to show it on: a real one, switched on (while the lid is shut or
# the laptop sleeps, Hyprland may have none, or only its stand-in, FALLBACK)
screen_here() {
    hyprctl monitors -j 2>/dev/null | jq -e 'map(select(.name != "FALLBACK" and (.disabled // false) == false)) | length > 0' >/dev/null 2>&1
}
wait_for_screen() {
    local i
    for ((i = 0; i < 600; i++)); do      # (up to 10 minutes, then try anyway)
        screen_here && return 0
        sleep 1
    done
}

crashes=()
while true; do
    wait_for_screen
    qs "$@"
    code=$?
    case $code in
        0 | 130 | 143) exit 0 ;;          # quit, Ctrl+C, or stopped on purpose
    esac
    now=$(date +%s)
    # it stops when its screen goes (the lid, sleep): not a crash; it starts
    # again when the screen is back
    if ! screen_here; then
        echo "$(date '+%F %T') the shell stopped with its screen (exit $code); starting it again when the screen is back" >>"$state/shell-crashes"
        sleep 1
        continue
    fi
    echo "$(date '+%F %T') the shell stopped (exit $code); starting it again" >>"$state/shell-crashes"
    crashes+=("$now")
    recent=0
    for t in "${crashes[@]}"; do (( now - t < 120 )) && recent=$((recent + 1)); done
    if (( recent >= 5 )); then
        echo "$(date '+%F %T') 5 crashes in 2 minutes: not starting it again" >>"$state/shell-crashes"
        exit 1
    fi
    sleep 1
done
