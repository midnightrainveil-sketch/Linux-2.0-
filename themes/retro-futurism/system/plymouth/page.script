# Magnetic 88: the page shown while the machine starts and stops (Plymouth).
# The lock screen goes on: the station platform at dusk (her waiting while
# it starts, the platform empty as it shuts down), and in front of it the
# access pass rising into place, its screen lighting up with what is
# happening, a glow running along its row of lights, its lamp breathing.
# The pictures come from tools/make_splash.py, drawn for an 1800 px tall
# screen (the G14) and fitted to others. Positions on the pass are in its
# own pixels (device.png: 1162 x 1201).

W = Window.GetWidth();
H = Window.GetHeight();
k = H / 1800;
s = k * 0.82;                       # the pass's scale: about half the screen's height

fun scaled(img, f) {
    return img.Scale(Math.Int(img.GetWidth() * f + 0.5), Math.Int(img.GetHeight() * f + 0.5));
}

# what is happening
mode = Plymouth.GetMode();
which = "boot";
if (mode == "shutdown") which = "shutdown";
if (mode == "reboot") which = "reboot";
if (mode == "updates" || mode == "system-upgrade" || mode == "firmware-upgrade") which = "updates";

# ------------------------------------------------------------------ the platform
Window.SetBackgroundTopColor(0.05, 0.04, 0.05);
Window.SetBackgroundBottomColor(0.05, 0.04, 0.05);
if (which == "shutdown") bg_img = Image("bg-shutdown.png"); else bg_img = Image("bg-boot.png");
f = Math.Max(W / bg_img.GetWidth(), H / bg_img.GetHeight());
bg_img = scaled(bg_img, f);
bg = Sprite(bg_img);
bg.SetPosition(Math.Int((W - bg_img.GetWidth()) / 2), Math.Int((H - bg_img.GetHeight()) / 2), 0);

# ------------------------------------------------------------------ the pass
dev_img = scaled(Image("device.png"), s);
dx = Math.Int(W * 0.38 - dev_img.GetWidth() / 2);     # (a little left of the middle: she waits on the right)
dy0 = Math.Int((H - dev_img.GetHeight()) / 2);
rise = 40 * k;
fun at_x(x) { return dx + x * s; }

# (its shadow is drawn a quarter size, from 160 px up and left of the pass,
# and falls a little below it)
shadow_img = scaled(Image("shadow.png"), 4 * s);
shadow = Sprite(shadow_img);
shadow.SetOpacity(0);
device = Sprite(dev_img);
device.SetOpacity(0);
face_img = scaled(Image("face-" + which + ".png"), s);
face = Sprite(face_img);
face.SetOpacity(0);

# the row of lights, its label, the lamp
n = 10;
on_img = scaled(Image("dot-on.png"), s);
off_img = scaled(Image("dot-off.png"), s);
lab_progress = scaled(Image("label-progress.png"), s);
lab_key = scaled(Image("label-key.png"), s);
label = Sprite(lab_progress);
label.SetOpacity(0);
offs = [];
ons = [];
for (i = 0; i < n; i++) {
    offs[i] = Sprite(off_img);
    offs[i].SetOpacity(0);
    ons[i] = Sprite(on_img);
    ons[i].SetOpacity(0);
}
pulse = Sprite(scaled(Image("pulse.png"), s));
pulse.SetOpacity(0);

fun place(y0) {
    shadow.SetPosition(Math.Int(dx - 160 * s), Math.Int(y0 - 160 * s), 1);
    device.SetPosition(dx, Math.Int(y0), 2);
    face.SetPosition(dx, Math.Int(y0), 3);
    label.SetPosition(Math.Int(at_x(154 - 30)), Math.Int(y0 + (847 - 24) * s), 4);
    for (i = 0; i < n; i++) {
        cx = 172 + i * 58;
        offs[i].SetPosition(Math.Int(at_x(cx - 60)), Math.Int(y0 + (919 - 60) * s), 4);
        ons[i].SetPosition(Math.Int(at_x(cx - 60)), Math.Int(y0 + (919 - 60) * s), 5);
    }
    pulse.SetPosition(Math.Int(at_x(175 - 60)), Math.Int(y0 + (1054 - 60) * s), 4);
}

# ------------------------------------------------------------------ the passphrase (an encrypted disk)
asking = 0;
typed = 0;
fun on_password(prompt_text, count) {
    global.asking = 1;
    global.typed = count;
    label.SetImage(lab_key);
}
fun on_normal() {
    global.asking = 0;
    global.typed = 0;
    label.SetImage(lab_progress);
}
Plymouth.SetDisplayPasswordFunction(on_password);
Plymouth.SetDisplayNormalFunction(on_normal);

# ------------------------------------------------------------------ coming on
t = 0;

fun ease(x) {
    if (x <= 0) return 0;
    if (x >= 1) return 1;
    return x * x * (3 - 2 * x);
}

fun refresh() {
    global.t = t + 1 / 50;
    # the pass rises into place
    a = ease(t / 0.9);
    place(dy0 + rise * (1 - a));
    shadow.SetOpacity(a);
    device.SetOpacity(a);
    # its screen lights up, with the flicker of a screen coming on
    b = ease((t - 0.7) / 0.5);
    flick = 1;
    if (t > 0.78 && t < 0.86) flick = 0.35;
    face.SetOpacity(b * flick);
    label.SetOpacity(b * flick);
    # the lights: a glow running along them, there and back; or, asked for
    # the disk's key, one lit for each letter typed
    c = ease((t - 1.1) / 0.5);
    sw = (t - 1.1) * 0.5;
    sw = sw - Math.Int(sw);
    if (sw < 0.5) pos = sw * 2 * (n - 1); else pos = (1 - sw) * 2 * (n - 1);
    for (i = 0; i < n; i++) {
        offs[i].SetOpacity(c);
        if (asking) {
            if (i < typed) v = 1; else v = 0;
        } else {
            d = Math.Abs(i - pos) / 1.8;
            if (d >= 1) v = 0; else v = (1 - d) * (1 - d);
        }
        ons[i].SetOpacity(c * v);
    }
    # the lamp beside what it is doing, breathing
    pulse.SetOpacity(c * (0.55 + 0.45 * Math.Cos(t * 3.2)));
}
Plymouth.SetRefreshFunction(refresh);
