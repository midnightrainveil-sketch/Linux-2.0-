{
  "id": "archive",
  "name": "Archive",
  "by": "Built in",
  "summary": "A botanical herbarium on paper: windows as typed index cards, the month's pressed specimen, a turntable, a field notebook, and a cyanotype sheet by night.",
  "previews": [
    "preview-day.jpg",
    "preview-phonograph.jpg",
    "preview-night.jpg"
  ],
  "captions": [
    "By day.",
    "The phonograph.",
    "By night."
  ],
  "own": {
    "when": ".config/ultra/archive/wallpaper.*",
    "skip": [
      ".local/share/ultra/archive/plates/0001-*",
      ".local/share/ultra/archive/plates/0001/*",
      ".local/share/ultra/archive/plates/index.json"
    ]
  },
  "leaves": [
    ".config/gtk-3.0/gtk.css",
    ".config/gtk-4.0/gtk.css"
  ]
}
