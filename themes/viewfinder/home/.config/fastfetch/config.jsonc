// fastfetch: the terminal's greeting, as on the reference picture: the
// dashed mark, then a few readings in small capitals.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "default" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": " ",
    "color": { "keys": "default", "title": "default", "output": "default" },
    "key": { "width": 9 }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "{#90}─────────────────{#}" },
    { "type": "os", "key": "OS:", "format": "{name} {arch}" },
    { "type": "kernel", "key": "KERNEL:", "format": "{release}" },
    { "type": "packages", "key": "PKGS:", "format": "{all}" },
    { "type": "shell", "key": "SHELL:", "format": "{pretty-name} {version}" },
    { "type": "wm", "key": "WM:", "format": "{pretty-name}" },
    { "type": "memory", "key": "MEM:", "format": "{used} / {total}" },
    "break"
  ]
}
